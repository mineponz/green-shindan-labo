---
/** ヘッダーのワードマーク横に置く葉のマーク。外部画像は使わず自作SVGで完結させる。 */
interface Props {
  size?: number;
}
const { size = 24 } = Astro.props;
---

<svg
  class="leaf-mark"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <path
    d="M20 4c0 9-5 14-12 14-2 0-3-.4-3-.4S4 8 20 4Z"
    fill="currentColor"
    opacity="0.85"
  />
  <path d="M18 6C12 8 8 13 5 21" stroke="var(--surface)" stroke-width="1.4" stroke-linecap="round" />
</svg>

<style>
  .leaf-mark {
    color: var(--accent);
    flex-shrink: 0;
  }
</style>
