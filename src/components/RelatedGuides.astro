---
import { otherGuides } from '../lib/guides.ts';

/**
 * 記事末尾に出す「ほかのガイド記事」。
 * 2026-08-22、9本目追加を機に先頭4件（GUIDESの並び＝読んでほしい順）に絞った
 * （本数が少ないうちは全件表示していたが、全部出すと縦に長くなりすぎるため）。
 * リンクは三次アクション扱い（リンクのみ・塗りつぶさない / design.md の視覚的階層）。
 */
const RELATED_GUIDES_LIMIT = 4;

interface Props {
  /** 今読んでいる記事のslug。これ自身は一覧から外す */
  currentSlug: string;
}

const { currentSlug } = Astro.props;
const guides = otherGuides(currentSlug, RELATED_GUIDES_LIMIT);
---

{guides.length > 0 && (
  <section class="related">
    <h2>ほかのガイド記事</h2>
    <ul class="related-list">
      {guides.map((guide) => (
        <li>
          <a href={`/guides/${guide.slug}/`}>{guide.title}</a>
          <span class="summary">{guide.summary}</span>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .related-list {
    display: grid;
    gap: var(--space-2);
    list-style: none;
    /* main ul の既定padding（インデント）を打ち消す */
    margin: 0;
    padding: 0;
  }
  .related-list li {
    display: grid;
    gap: 0;
    margin: 0;
  }
  .related-list a {
    font-weight: 600;
  }
  .summary {
    color: var(--muted);
    font-size: var(--text-sm);
  }
</style>
