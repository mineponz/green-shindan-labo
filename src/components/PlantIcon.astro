---
/**
 * 植物ごとのアイコン（自作のシンプルなSVG）。写真素材は権利関係が面倒なので使わず、
 * サイトのデザイントークン（currentColor）だけで描いている。
 * 一覧カード・診断結果カード・記事見出しで共通して使う。
 */
interface Props {
  slug: string;
  size?: number;
}
const { slug, size = 32 } = Astro.props;
---

<svg
  class="plant-icon"
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  {slug === 'pachira' && (
    <g>
      {/* 5枚の手のひら状の葉 */}
      <g fill="currentColor" opacity="0.85">
        <ellipse cx="16" cy="5" rx="2.2" ry="5" />
        <ellipse cx="16" cy="5" rx="2.2" ry="5" transform="rotate(35 16 10)" />
        <ellipse cx="16" cy="5" rx="2.2" ry="5" transform="rotate(-35 16 10)" />
        <ellipse cx="16" cy="6" rx="2" ry="4.5" transform="rotate(68 16 10)" />
        <ellipse cx="16" cy="6" rx="2" ry="4.5" transform="rotate(-68 16 10)" />
      </g>
      {/* 編み込みの幹 */}
      <path
        d="M16 11v8M13 13c2 2 4 4 6 6M19 13c-2 2-4 4-6 6"
        stroke="currentColor"
        stroke-width="1.6"
        opacity="0.6"
        stroke-linecap="round"
      />
      <path d="M9 24h14l-1.5 5h-11L9 24Z" fill="currentColor" opacity="0.35" />
    </g>
  )}

  {slug === 'monstera' && (
    <g>
      {/* 切れ込み（ノッチ）を輪郭そのものに入れた葉。
          単純な円＋十字線だと「丸に＋」に見えてしまうため、外形で切れ込みを表現する */}
      <path
        d="M16 3c5 0 9 2.5 10.5 6L18.5 11l8.5 1.5c.5 3-.5 5.5-2.5 7.5L18 18.5l5.5 3c-2 2-4.5 3.3-7.5 4-3-.7-5.5-2-7.5-4l5.5-3-6.5 1.5c-2-2-3-4.5-2.5-7.5L13.5 11 5.5 9C7 5.5 11 3 16 3Z"
        fill="currentColor"
        opacity="0.85"
      />
      <path d="M16 5v19" stroke="var(--surface)" stroke-width="1.4" stroke-linecap="round" />
      <path d="M15.2 24h1.6v6h-1.6z" fill="currentColor" opacity="0.5" />
    </g>
  )}

  {slug === 'sansevieria' && (
    <g>
      {/* まっすぐ伸びる肉厚の葉 */}
      <g fill="currentColor">
        <path d="M15 2c1.6 0 2.6 1.4 2.6 4v18h-5.2V6c0-2.6 1-4 2.6-4Z" opacity="0.85" />
        <path d="M9 8c1.4 0 2.2 1.2 2.2 3.4V24H6.8V11.4C6.8 9.2 7.6 8 9 8Z" opacity="0.6" />
        <path d="M22 6c1.4 0 2.2 1.2 2.2 3.4V24h-4.4V9.4C19.8 7.2 20.6 6 22 6Z" opacity="0.7" />
      </g>
      <path d="M6 24h20l-1.5 5h-17L6 24Z" fill="currentColor" opacity="0.35" />
    </g>
  )}

  {slug === 'pothos' && (
    <g>
      {/* 垂れ下がるつると、そこに付く葉。線だけだと細くて弱いので葉を大きめに取る */}
      <path
        d="M11 2c0 7 3 11 4.5 16.5C16.6 22.5 16.6 26.5 15.5 30"
        stroke="currentColor"
        stroke-width="1.6"
        opacity="0.5"
        fill="none"
        stroke-linecap="round"
      />
      <g fill="currentColor">
        <ellipse cx="6" cy="8" rx="4.6" ry="3.2" transform="rotate(-25 6 8)" opacity="0.75" />
        <ellipse cx="19" cy="12" rx="4.8" ry="3.3" transform="rotate(22 19 12)" opacity="0.9" />
        <ellipse cx="7.5" cy="19" rx="4.6" ry="3.2" transform="rotate(-22 7.5 19)" opacity="0.7" />
        <ellipse cx="21" cy="24" rx="4.4" ry="3" transform="rotate(20 21 24)" opacity="0.85" />
      </g>
    </g>
  )}

  {slug === 'gajumaru' && (
    <g>
      {/* もこもこの樹冠と太った幹（気根） */}
      <g fill="currentColor" opacity="0.85">
        <circle cx="12" cy="9" r="6" />
        <circle cx="21" cy="11" r="5" />
        <circle cx="16" cy="6" r="4.5" />
      </g>
      <path
        d="M15 15c-.5 4-3 5-3.5 9h9c-.6-4-3-5-3.5-9h-2Z"
        fill="currentColor"
        opacity="0.6"
      />
      <path d="M8 24h16l-1.2 5H9.2L8 24Z" fill="currentColor" opacity="0.35" />
    </g>
  )}
</svg>

<style>
  .plant-icon {
    color: var(--accent);
    flex-shrink: 0;
  }
</style>
