---
/**
 * 植物ごとのアイコン（自作のシンプルなSVG）。写真素材は権利関係が面倒なので使わず、
 * サイトのデザイントークン（currentColor）だけで描いている。
 * 一覧カード・診断結果カード・記事見出しで共通して使う。
 */
interface Props {
  slug: string;
  size?: number;
}
const { slug, size = 32 } = Astro.props;
---

<svg
  class="plant-icon"
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  {slug === 'pachira' && (
    <g>
      {/* 5枚の手のひら状の葉 */}
      <g fill="currentColor" opacity="0.85">
        <ellipse cx="16" cy="5" rx="2.2" ry="5" />
        <ellipse cx="16" cy="5" rx="2.2" ry="5" transform="rotate(35 16 10)" />
        <ellipse cx="16" cy="5" rx="2.2" ry="5" transform="rotate(-35 16 10)" />
        <ellipse cx="16" cy="6" rx="2" ry="4.5" transform="rotate(68 16 10)" />
        <ellipse cx="16" cy="6" rx="2" ry="4.5" transform="rotate(-68 16 10)" />
      </g>
      {/* 編み込みの幹 */}
      <path
        d="M16 11v8M13 13c2 2 4 4 6 6M19 13c-2 2-4 4-6 6"
        stroke="currentColor"
        stroke-width="1.6"
        opacity="0.6"
        stroke-linecap="round"
      />
      <path d="M9 24h14l-1.5 5h-11L9 24Z" fill="currentColor" opacity="0.35" />
    </g>
  )}

  {slug === 'monstera' && (
    <g>
      {/* 切れ込みの入った大きな葉 */}
      <path
        d="M16 3c8 0 12 6 12 11s-5 9-12 9S4 19 4 14 8 3 16 3Z"
        fill="currentColor"
        opacity="0.85"
      />
      <g stroke="var(--surface)" stroke-width="1.6" stroke-linecap="round">
        <path d="M16 6v16" />
        <path d="M16 11h7M16 16h6M16 11H9M16 16h-6" />
      </g>
      <path d="M15 22h2v7h-2z" fill="currentColor" opacity="0.5" />
    </g>
  )}

  {slug === 'sansevieria' && (
    <g>
      {/* まっすぐ伸びる肉厚の葉 */}
      <g fill="currentColor">
        <path d="M15 2c1.6 0 2.6 1.4 2.6 4v18h-5.2V6c0-2.6 1-4 2.6-4Z" opacity="0.85" />
        <path d="M9 8c1.4 0 2.2 1.2 2.2 3.4V24H6.8V11.4C6.8 9.2 7.6 8 9 8Z" opacity="0.6" />
        <path d="M22 6c1.4 0 2.2 1.2 2.2 3.4V24h-4.4V9.4C19.8 7.2 20.6 6 22 6Z" opacity="0.7" />
      </g>
      <path d="M6 24h20l-1.5 5h-17L6 24Z" fill="currentColor" opacity="0.35" />
    </g>
  )}

  {slug === 'pothos' && (
    <g>
      {/* 垂れ下がるつるとハート型の葉 */}
      <path
        d="M6 5c0 8 6 10 8 16"
        stroke="currentColor"
        stroke-width="1.6"
        opacity="0.6"
        fill="none"
        stroke-linecap="round"
      />
      <path
        d="M24 7c0 9-6 12-8 20"
        stroke="currentColor"
        stroke-width="1.6"
        opacity="0.6"
        fill="none"
        stroke-linecap="round"
      />
      <g fill="currentColor" opacity="0.85">
        <path d="M9 9c2.5-1 5 .5 4.6 3-.3 2-2.7 3.4-4.6 3.6-1-1.6-1.6-4.6 0-6.6Z" />
        <path d="M22 13c-2.5-1-5 .5-4.6 3 .3 2 2.7 3.4 4.6 3.6 1-1.6 1.6-4.6 0-6.6Z" />
        <path d="M13 20c2.5-1 5 .5 4.6 3-.3 2-2.7 3.4-4.6 3.6-1-1.6-1.6-4.6 0-6.6Z" opacity="0.75" />
      </g>
    </g>
  )}

  {slug === 'gajumaru' && (
    <g>
      {/* もこもこの樹冠と太った幹（気根） */}
      <g fill="currentColor" opacity="0.85">
        <circle cx="12" cy="9" r="6" />
        <circle cx="21" cy="11" r="5" />
        <circle cx="16" cy="6" r="4.5" />
      </g>
      <path
        d="M15 15c-.5 4-3 5-3.5 9h9c-.6-4-3-5-3.5-9h-2Z"
        fill="currentColor"
        opacity="0.6"
      />
      <path d="M8 24h16l-1.2 5H9.2L8 24Z" fill="currentColor" opacity="0.35" />
    </g>
  )}
</svg>

<style>
  .plant-icon {
    color: var(--accent);
    flex-shrink: 0;
  }
</style>
