---
// トップページ用の装飾イラスト。写真素材は使わず、サイトのデザイントークン
// var(--accent) / var(--border) だけで完結する自作のライン画SVG。
---

<div class="hero-illustration" aria-hidden="true">
  <svg viewBox="0 0 320 88" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
    <!-- 左: 垂れ下がるポトス -->
    <g>
      <path
        d="M46 44c-2 12-10 18-16 28M46 44c2 12 10 16 14 26"
        stroke="var(--accent)"
        stroke-width="1.6"
        fill="none"
        opacity="0.5"
        stroke-linecap="round"
      />
      <g fill="var(--accent)" opacity="0.55">
        <path d="M34 58c4-2 8 1 7.5 4.5C41 66 37 68 34 68c-1.6-3-2.6-7.4-0-10Z" />
        <path d="M58 60c-4-2-8 1-7.5 4.5C51 68 55 70 58 70c1.6-3 2.6-7.4 0-10Z" />
      </g>
      <path d="M36 40h20l-3 12H39l-3-12Z" fill="var(--accent)" opacity="0.35" />
    </g>

    <!-- 中央: パキラ -->
    <g>
      <g fill="var(--accent)" opacity="0.6">
        <ellipse cx="150" cy="18" rx="4" ry="11" />
        <ellipse cx="150" cy="18" rx="4" ry="11" transform="rotate(40 150 28)" />
        <ellipse cx="150" cy="18" rx="4" ry="11" transform="rotate(-40 150 28)" />
        <ellipse cx="150" cy="20" rx="3.4" ry="9" transform="rotate(72 150 28)" />
        <ellipse cx="150" cy="20" rx="3.4" ry="9" transform="rotate(-72 150 28)" />
      </g>
      <path
        d="M150 32v20M143 36c4 4 9 9 13 13M157 36c-4 4-9 9-13 13"
        stroke="var(--accent)"
        stroke-width="2"
        opacity="0.45"
        stroke-linecap="round"
      />
      <path d="M136 54h28l-4 18h-20l-4-18Z" fill="var(--accent)" opacity="0.35" />
    </g>

    <!-- 右: サンスベリア -->
    <g>
      <g fill="var(--accent)" opacity="0.55">
        <path d="M262 20c2.4 0 3.8 2 3.8 6v30h-7.6V26c0-4 1.4-6 3.8-6Z" />
        <path d="M252 32c2 0 3.2 1.8 3.2 5v19h-6.4V37c0-3.2 1.2-5 3.2-5Z" />
        <path d="M274 28c2 0 3.2 1.8 3.2 5v23h-6.4V33c0-3.2 1.2-5 3.2-5Z" />
      </g>
      <path d="M246 56h34l-4 16h-26l-4-16Z" fill="var(--accent)" opacity="0.35" />
    </g>

    <!-- 床のライン -->
    <path d="M8 74h304" stroke="var(--border)" stroke-width="1.5" fill="none" />
  </svg>
</div>

<style>
  .hero-illustration {
    margin: var(--space-1) 0 var(--space-3);
  }
  .hero-illustration svg {
    display: block;
    width: 100%;
    max-width: 26rem;
    margin-inline: auto;
    height: auto;
  }
</style>
