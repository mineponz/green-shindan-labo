---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideArticleHeader from '../../components/GuideArticleHeader.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import AmazonLink from '../../components/AmazonLink.astro';
import BackToDiagnosis from '../../components/BackToDiagnosis.astro';
import TableScroll from '../../components/TableScroll.astro';
import { findGuide } from '../../lib/guides.ts';

const guide = findGuide('entrance-tree')!;

/**
 * 早見表用データ。このサイトの `plants.ts` には屋外の木が入っていないため
 * （診断ツールの対象は観葉植物8種のみ）、他のガイド記事のように plants.ts から
 * 動的生成せず、ここに直接書いている（個別ページへのリンクも作らない）。
 * 数値・性質は researcher報告（vault: 1-projects/green-lab/tasks/20260921-add-entrance-tree-guide.md
 * の「事実確認の結果」）にある範囲だけを使う。資料が割れている項目（根の深浅など）は断定しない。
 */
const ENTRANCE_TREES: {
  name: string;
  leafType: string;
  height: string;
  growth: string;
  sun: string;
  caution: string;
}[] = [
  {
    name: 'ソヨゴ',
    leafType: '常緑',
    height: '3〜4m（管理時）',
    growth: 'ゆっくり（10年で2〜3m）',
    sun: '日なた〜半日陰（西日は苦手）',
    caution: '実は雌株だけ。気になるなら雄株を',
  },
  {
    name: 'ハイノキ',
    leafType: '常緑',
    height: '3〜4m',
    growth: 'ゆるやか',
    sun: '日なた〜半日陰（強い直射で葉焼け）',
    caution: '根が浅めで乾燥に弱い。マルチングが効く',
  },
  {
    name: 'アオダモ',
    leafType: '落葉',
    height: '〜5m程度',
    growth: '遅い（剪定は2年に1回程度）',
    sun: '日なた〜明るい半日陰',
    caution: '丈夫で育てやすい。冬は落葉して枝だけに',
  },
  {
    name: 'ヤマボウシ',
    leafType: '落葉（常緑品種もあり）',
    height: '3〜5m',
    growth: '比較的ゆるやか',
    sun: '日なた〜半日陰',
    caution: '病害虫に強い。花も紅葉も楽しめる',
  },
  {
    name: 'ジューンベリー',
    leafType: '落葉',
    height: '2〜3m（最大5m程度）',
    growth: 'ふつう',
    sun: '半日陰が向く（夏の西日・乾燥は苦手）',
    caution: '実が落ちるのでタイル・コンクリート際は避ける',
  },
  {
    name: 'オリーブ（条件付き）',
    leafType: '常緑',
    height: '剪定次第（資料により差が大きい）',
    growth: '資料により差あり',
    sun: '日当たりを好む',
    caution: '根が舗装を傷める例も。寒冷地は地植え不可',
  },
];
---

<BaseLayout
  title={guide.navLabel}
  description={guide.description}
  breadcrumb={[{ label: 'ガイド記事', href: '/guides/' }]}
  ogImagePath="/og/guide-entrance-tree.jpg"
>
  <GuideArticleHeader guide={guide} />

  <h2>地面が持ち上がるのはなぜ？</h2>
  <p>
    玄関まわりのアプローチやタイルが、ボコッと盛り上がってしまうあの現象。
    あれは木そのものが悪いというより、<strong>木の根の性質</strong>が原因で起きています。
    木の中には、太い根を地表のすぐ下で横方向に広げながら育つ性質を持つものがあり、
    その根が太っていくにつれて、上に乗っているタイルや土間のコンクリートを下から
    少しずつ押し上げてしまうんです。
  </p>
  <p>
    厄介なのは、<strong>成長が早い木ほどこれが起きやすい</strong>ということ。勢いよく育つ木は、根も
    それだけ早く広がっていくので、気づいたときにはアプローチの際まで届いていた、ということになりがちです。
    実際、街路樹として植えられたケヤキやサクラの根上がり（根が舗装を持ち上げる現象）は、
    論文や自治体の資料でも被害として報告されています。竹や笹にいたっては地下茎そのものが
    1年に数mも伸び、基礎や配管まで傷めた例があるほどです（このあたりは後の章で詳しく触れます）。
  </p>
  <p>
    つまり玄関に木を植えるとき、私は「大きさ」より先に「根がどう育つ木か」を見るべきだと
    思っています。
  </p>

  <h2>木を選ぶときの3つの目安と、株立ちが玄関向きな理由</h2>
  <p>
    ここまでを踏まえて、私なりに選ぶ目安を整理すると3つに絞られます。
  </p>
  <ul>
    <li>
      <strong>成長がゆっくりであること。</strong>
      急成長する木は根も枝も勢いよく広がるので、数年で持て余しやすくなります
    </li>
    <li>
      <strong>最終的な樹高が身の丈に合うこと。</strong>
      目安として2〜4m程度で管理を続けられる木なら、玄関の顔として大きすぎず
      小さすぎずのバランスが取りやすいです
    </li>
    <li>
      <strong>根が暴れにくいこと。</strong>
      地表近くを勢いよく横に這うタイプではなく、比較的おとなしく育つ木を選ぶと安心です
    </li>
  </ul>
  <p>
    この3つを満たす木は、正直そう多くありません。「人気だから」「よく見かけるから」だけで
    決めず、次の章で挙げる候補から選んでほしいと思います。
  </p>
  <p>
    もうひとつ、個人的に推したいのが<strong>「株立ち」</strong>の仕立てです。1本の幹が
    まっすぐ立ち上がる「単幹」ではなく、根元近くから何本かの細い幹に分かれて育つ姿のことで、
    同じ高さでも単幹より軽やかに見え、玄関まわりの限られたスペースに置いても圧迫感が
    出にくいんです。気になる方は、園芸店やネット通販で探すときに「株立ち」で検索して
    みてください。
  </p>

  <h2>玄関におすすめの木5選</h2>
  <p>
    候補を絞り込むと、私は次の5種をおすすめしたいです。それぞれ個性が違うので、
    玄関の雰囲気や日当たりと相談しながら選んでみてください。
  </p>

  <h3>ソヨゴ — 常緑で、のんびり育つ。赤い実は雌株だけ</h3>
  <p>
    常緑樹で、成長はかなりゆっくりです。10年育てても2〜3m程度というくらいで、
    毎年の剪定に追われる心配は少なそうです。管理された樹形でも3〜4mほどに収まるので、
    玄関の背景としてちょうどいいサイズ感になります。根は浅く張るという記述がありますが、
    舗装を持ち上げたという具体的な報告は見当たりませんでした。
  </p>
  <p>
    ひとつだけ覚えておいてほしいのが、<strong>赤い実がなるのは雌株だけ</strong>ということです。
    実が落ちるのが気になる方は、実のつかない雄株を選ぶといいと思います。西日はあまり
    得意ではないので西向きの玄関は避けたほうがよさそうですし、カイガラムシが付くことも
    あるので、たまに幹まわりをのぞいてあげてください。
  </p>

  <h3>ハイノキ — 常緑で自然な樹形。乾燥だけ気にかけて</h3>
  <p>
    こちらも常緑樹で、成長はゆるやかです。自然樹高は3〜4mほど。根が浅めで乾燥に弱い
    ところがあるので、株元をマルチング（バークチップなど）で覆ってあげると水切れを
    防ぎやすくなります。暖かい地域を好む木なので、北関東のように冬の冷え込みが強い
    地域では、冬のあいだ落葉してしまうこともあるようです。真夏の強い直射日光では
    葉焼けすることもあるので、西日がきつく当たる場所は避けたほうが無難です。
  </p>

  <h3>アオダモ — バットの木としても知られる、マイペースな育ち</h3>
  <p>
    落葉樹で、庭植えなら5m程度まで育ちます。成長は遅めで、剪定も2年に1回くらいで
    十分なくらいマイペースです。北海道南部から九州まで自生している木で、丈夫さには
    定評があります。根がどのくらい深く張るかは資料によって記述が割れていたので、
    ここでは断定を避けておきます。冬に葉が落ちて枝だけになる姿も、季節の移ろいを
    感じられて私は好きです。
  </p>

  <h3>ヤマボウシ — 花も紅葉も楽しめる、丈夫な定番</h3>
  <p>
    落葉樹ですが、常緑タイプの品種もあります。常緑ヤマボウシは、後で触れるシマトネリコの
    代わりとしてもよく選ばれている定番の木です。樹高は3〜5mほどで、病害虫に強く
    育てやすさでも人気があります。根の深さについてはアオダモと同じく資料によって
    記述が割れていたので、深根性・浅根性のどちらとも断定しません。花も紅葉も楽しめて、
    季節ごとに表情が変わるのも魅力です。
  </p>

  <h3>ジューンベリー — おいしい実は、植える場所を選びます</h3>
  <p>
    落葉樹で、樹高は2〜3m（大きくても5m程度）。半日陰でも育つので、日当たりがそこまで
    強くない玄関にも向いていますし、寒さにも比較的強く、東北から九州まで育てられるそうです。
  </p>
  <p>
    ただし気をつけたいのが実です。初夏に実がなって食べられるのですが、熟すと
    落果します。落ちた実をそのままにすると<strong>鳥のフンで汚れたり、潰れた実に虫が
    寄ってきたりする</strong>ことがあるので、<strong>タイルやコンクリートのすぐ横に植えるのは避けて、
    土や下草の近くに植える</strong>のがおすすめです。落ちた実の掃除がしやすい場所を
    選んであげると、気楽に実りも楽しめます。
  </p>

  <h2>玄関には避けたい木</h2>
  <p>
    逆に、玄関には避けたほうがいい木もはっきりしています。人気があっても、根の性質や
    大きさの面で、今回の条件とはあまり相性がよくない木たちです。
  </p>

  <h3>シマトネリコ — 人気だけど、根が強く速い</h3>
  <p>
    観葉植物のような葉と丈夫さで人気の常緑樹ですが、正直、今回の条件とは相性がよくありません。
    根は浅く、しかも急速に広がる性質があり、舗装を押し上げてしまう例が報告されています。
    成長も早く、樹形を保つには年に1〜2回の剪定が必要になるので、「植えたら放っておける」
    というわけにはいきません。人気の木なだけに、外すのは私も少し悩ましいところですが、
    玄関の舗装際に植えるのは避けたほうがよさそうです。
  </p>

  <h3>ケヤキ・サクラ — 大きく育つ木の代表格</h3>
  <p>
    街路樹としてもおなじみのケヤキやサクラは、成木になると大木に育ちます。根上がり
    （根が舗装を持ち上げる現象）は論文や自治体の資料でも実証されている、いわば
    「実績のある」被害例です。玄関先の限られたスペースには、そもそもサイズ感が
    合わない木だと思います。
  </p>

  <h3>竹・笹 — 地下茎の広がりが読めない</h3>
  <p>
    竹や笹は地下茎が1年に数mも伸びることがあり、
    気づいたときには基礎の下や配管のあたりまで到達していた、という被害例もあります。
    一度地下茎が広がってしまうと取り除くのも一苦労なので、玄関先には正直おすすめできません。
  </p>

  <h3>オリーブ — 人気だけど、玄関の舗装際は注意</h3>
  <p>
    最後に、悩ましいオリーブについても触れておきます。シンボルツリーとして人気の高い木で、
    私も見た目はとても好きです。ただ、販売店の情報では根が浅く張る性質があり、
    コンクリートを持ち上げるリスクがあるという声もあります。実が熟すとタイルを汚すことも
    あるようです。加えて<strong>寒さにあまり強くないため、寒冷地では地植えができません</strong>
    （寒い地域で育てたいなら、鉢植えにするのが無難です）。
  </p>
  <p>
    今回は「根が舗装を傷めにくいこと」をいちばんの条件にしたので、おすすめの5種からは
    外しましたが、育てる環境や置き場所によっては十分に選択肢になる木だと思います。
    植えるなら、舗装のすぐ際は避けて、土のスペースに余裕がある場所を選んでください。
  </p>

  <h2>植えるときのひと工夫</h2>
  <p>
    おすすめの木を選んでも、植え方次第でその後の安心感は変わります。調べていて
    「これは知っておいてよかった」と思ったポイントを3つ挙げておきます。
  </p>
  <ul>
    <li>
      <strong>防根シートを使う。</strong>
      根が伸びてほしくない方向（アプローチ側など）に、根の侵入を防ぐシートを
      埋め込んでおく方法です。物理的に遮るタイプと薬剤で成長を抑えるタイプの2種類が
      ありますが、どちらも継ぎ目や下端に隙間があると根はそこから抜けてしまいます。
      すき間なく施工することが前提の対策で、これさえやれば万能というものではありません
    </li>
    <li>
      <strong>アプローチや基礎のすぐ際には植えない。</strong>
      太い根がよく育つ木は、そもそも舗装や建物の基礎のすぐそばに植えないのが
      いちばん確実な対策です。「何cm離せばいい」という公的な基準は見当たらなかったので
      具体的な数値は書きませんが、根が四方八方に伸びられるだけのスペースを
      確保できる場所を選ぶのが安心です
    </li>
    <li>
      <strong>剪定で高さを抑える。</strong>
      大きくなりすぎるのを防ぐには、定期的な剪定が効果的です。ただし剪定は
      一度やって終わりではなく、毎年続けていくものだと考えておいてください。切りどきの
      見きわめ方や基本の切り方は
      <a href="/guides/pruning/">観葉植物の剪定・切り戻し、タイミングとやり方</a>にも
      共通する考え方が書いてあるので、参考にしてみてください
    </li>
  </ul>
  <AmazonLink keyword="防根シート 庭木" label="Amazonで「防根シート」を見る" />
  <AmazonLink keyword="剪定ばさみ 庭木用" label="Amazonで「庭木用の剪定ばさみ」を見る" />

  <h2>地植えが不安なら、大きな鉢で</h2>
  <p>
    ここまで読んで、それでも地植えは少し不安、という方には鉢植えという選択肢もあります。
    地面に直接根を張らせないので、根が舗装を持ち上げる心配そのものがなくなりますし、
    模様替えのように置き場所を変えられるのも気楽です。
  </p>
  <p>
    鉢は大きめの、存在感のあるものを選ぶのがコツです。玄関先は限られたスペースなので、
    小さな鉢が並んでいるよりも、大きな鉢に1本どっしり植えたほうが「玄関の顔」らしい
    印象になります。鉢そのものの選び方は
    <a href="/guides/pot-guide/">おしゃれな鉢・プランターの選び方</a>に、大きな鉢を
    使った飾り方の考え方は
    <a href="/guides/display-by-plant/">観葉植物の種類別の飾り方</a>にまとめているので、
    あわせて読んでみてください（このサイトは観葉植物向けの記事ですが、大きな鉢を選ぶ
    考え方はそのまま今回の木にも使えます）。
  </p>
  <AmazonLink keyword="大型プランター 庭木 屋外" label="Amazonで「大型プランター」を見る" />

  <h2>おすすめ5種＋オリーブの早見表</h2>
  <p>
    最後に、おすすめの5種とオリーブをまとめた早見表を置いておきます。選ぶときの
    参考にしてみてください。
  </p>
  <TableScroll label="玄関におすすめの木の早見表">
    <table class="entrance-table">
      <thead>
        <tr>
          <th scope="col">木</th>
          <th scope="col">常緑・落葉</th>
          <th scope="col">高さの目安</th>
          <th scope="col">育つ速さ</th>
          <th scope="col">日当たり</th>
          <th scope="col">気をつけること</th>
        </tr>
      </thead>
      <tbody>
        {ENTRANCE_TREES.map((tree) => (
          <tr>
            <th scope="row">{tree.name}</th>
            <td>{tree.leafType}</td>
            <td>{tree.height}</td>
            <td>{tree.growth}</td>
            <td>{tree.sun}</td>
            <td>{tree.caution}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </TableScroll>
  <p class="note">
    どの木も、選ぶときにいちばん見てほしいのは大きさより「根の育ち方」です。
    地植えに踏み切る前にもう少し迷いたいという人は、まず大きな鉢から始めてみるのも
    ひとつの手だと思います。
  </p>

  <RelatedGuides currentSlug={guide.slug} />

  <BackToDiagnosis />
</BaseLayout>

<style>
  /*
   * 早見表。ほかのガイドの比較表と見た目をそろえている
   * （横罫だけ・囲みの重さを出さない / design.md）。
   * 和文セルに white-space: nowrap は付けない（付けると文字数がそのまま列の最小幅になり、
   * SP幅でページごとはみ出す / 3-resources/knowledge/20260920-ja-table-nowrap-breaks-sp.md）。
   */
  .entrance-table {
    width: 100%;
    margin-bottom: var(--space-2);
    border-collapse: collapse;
    font-size: var(--text-sm);
    text-align: left;
  }
  .entrance-table th,
  .entrance-table td {
    padding: var(--space-1);
    border-bottom: 1px solid var(--border);
    vertical-align: top;
    font-weight: 400;
  }
  .entrance-table thead th {
    color: var(--muted);
    font-weight: 600;
  }
  .entrance-table tbody th {
    font-weight: 600;
  }

  /* 補足は本文より一段弱く（色を足さずミュートで後退させる / design.md） */
  .note {
    color: var(--muted);
    font-size: var(--text-sm);
  }
</style>
