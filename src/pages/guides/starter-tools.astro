---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideArticleHeader from '../../components/GuideArticleHeader.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import AmazonLink from '../../components/AmazonLink.astro';
import BackToDiagnosis from '../../components/BackToDiagnosis.astro';
import TableScroll from '../../components/TableScroll.astro';
import { findGuide } from '../../lib/guides.ts';

const guide = findGuide('starter-tools')!;

/**
 * 早見表「道具といつ要るか」。道具 → いつ要るか → 詳しく書いた記事の slug。
 * 順番と分け方はこのサイトの考え方（私見）で、一次の「正解リスト」ではない。
 * 内容は既存ガイドの記述の範囲だけ。新しい数値・商品名は書かない。
 * 記事リンクの表示名は guides.ts の navLabel を引く（手書きしない）。
 */
const TOOLS: { name: string; when: string; slugs: string[] }[] = [
  { name: '受け皿', when: '迎えた日から。たまった水は毎回捨てます', slugs: ['watering'] },
  { name: 'ジョウロ', when: '迎えた日から', slugs: ['watering'] },
  { name: '鉢カバー（使うなら）', when: '迎えた日から。中に水がたまっていないか確認します', slugs: ['after-purchase', 'pot-guide'] },
  { name: '霧吹き', when: '葉水やほこり落としのとき。チランジアは迎えた日から', slugs: ['leaf-cleaning', 'winter-humidity'] },
  { name: '一回り大きい鉢・培養土・鉢底ネット', when: '植え替えのとき', slugs: ['repotting', 'soil', 'pot-guide'] },
  { name: '肥料', when: '生長期に。迎えた直後・植え替え直後は与えません', slugs: ['fertilizer'] },
  { name: '切れ味のいい、清潔なハサミ', when: '伸びすぎて切り戻すとき', slugs: ['pruning'] },
  { name: '支柱', when: 'つる性の種類を上に伸ばしたくなったら', slugs: ['straight-growth'] },
  { name: '殺虫剤', when: '虫を見つけてから', slugs: ['pest-control'] },
  { name: '水分計', when: 'なくても困りません。感覚がつかめないうちや大きい鉢では楽です', slugs: ['watering'] },
  { name: '温湿度計', when: 'なくても困りません。季節の変わり目に数字で分かると安心です', slugs: ['winter-humidity', 'temperature-swings'] },
  { name: '植物育成ライト', when: 'なくても困りません。明るい窓辺があればたぶん要りません', slugs: ['grow-light'] },
  { name: 'サーキュレーター', when: 'なくても困りません', slugs: ['airflow'] },
  { name: '鉢スタンド', when: 'なくても困りません', slugs: ['display-ideas'] },
];
const linkOf = (slug: string) => ({ href: `/guides/${slug}/`, label: findGuide(slug)!.navLabel });
---

<BaseLayout
  title={guide.navLabel}
  description={guide.description}
  breadcrumb={[{ label: 'ガイド記事', href: '/guides/' }]}
  ogImagePath="/og/guide-starter-tools.jpg"
>
  <GuideArticleHeader guide={guide} />

  <h2>道具は「いつ要るか」で分けると迷いにくい</h2>
  <p>
    道具は「いつ要るか」で3つに分けて考えると、選びやすくなると私は思っています。
  </p>
  <ul>
    <li><strong>迎えた日から要るもの</strong></li>
    <li><strong>育ってきたら、困ったら買えばいいもの</strong></li>
    <li><strong>なくても困らないもの（あると便利）</strong></li>
  </ul>
  <p>
    この順番はあくまでこのサイトの考え方です。「最初にこれだけそろえればいい」という決まった一覧があるわけではないので、
    お部屋や植物に合わせて、気楽に読んでもらえるとうれしいです。
  </p>

  <h2>迎えた日から要るもの</h2>
  <p>
    迎えた日に必要な道具は、思ったより少なくていいです。
  </p>
  <ul>
    <li>
      <strong>受け皿：</strong>
      鉢の底から出た水を受けます。たまった水は毎回捨てます。
      考え方は<a href="/guides/watering/">観葉植物の水やりの頻度と量</a>にまとめています
    </li>
    <li>
      <strong>水やりの道具（ジョウロ）：</strong>
      注ぎ口が細いほうが根元を狙いやすいので、私は室内なら細口が使いやすいと思っています
    </li>
    <li>
      <strong>鉢カバー（使うなら）：</strong>
      中に水がたまりやすいので、たまっていないかを確認します。
      <a href="/guides/after-purchase/">買ってきたら最初にやることガイド</a>と
      <a href="/guides/pot-guide/">おしゃれな鉢・プランターの選び方</a>にも書いています
    </li>
  </ul>
  <p>
    土が乾いたかどうかは指や割り箸で確かめられるので、ここは道具なしでも大丈夫です。
    迎えた直後にやることは<a href="/guides/after-purchase/">買ってきたら最初にやることガイド</a>を見てみてください。
  </p>
  <p>
    例外は<a href="/plants/tillandsia/">チランジア（エアプランツ）</a>です。
    土を使わないので、霧吹きが水やりの道具になります。チランジアを迎えるなら、霧吹きも最初から用意しておきたいです。
  </p>
  <AmazonLink keyword="観葉植物 受け皿 鉢皿" label="Amazonで「受け皿」を見る" />
  <AmazonLink keyword="ジョウロ 細口 室内" label="Amazonで「細口のジョウロ」を見る" />

  <h2>育ってきたら・困ったときに買えばいいもの</h2>
  <p>
    ここに挙げたのは、必要になったときに買えば間に合うものです。
  </p>
  <ul>
    <li>
      <strong>一回り大きい鉢・培養土・鉢底ネット：</strong>
      植え替えのときに。<a href="/guides/repotting/">観葉植物の植え替えのタイミングとやり方</a>、
      <a href="/guides/soil/">観葉植物の土・用土選びガイド</a>、
      <a href="/guides/pot-guide/">おしゃれな鉢・プランターの選び方</a>を見てみてください
    </li>
    <li>
      <strong>肥料：</strong>
      生長期に与えるものです。迎えた直後と植え替え直後は与えません。
      <a href="/guides/fertilizer/">観葉植物の肥料ガイド</a>にまとめています
    </li>
    <li>
      <strong>切れ味のいい、清潔なハサミ：</strong>
      伸びすぎたときの切り戻しに。<a href="/guides/pruning/">観葉植物の剪定・切り戻しのタイミングとやり方</a>に書いています
    </li>
    <li>
      <strong>霧吹き：</strong>
      葉水やほこりを落とすときに。<a href="/guides/leaf-cleaning/">葉っぱの掃除のしかた</a>、
      <a href="/guides/winter-humidity/">冬の乾燥と部屋の加湿のしかた</a>があります
    </li>
    <li>
      <strong>支柱：</strong>
      つる性の種類を上に伸ばしたくなったら。<a href="/guides/straight-growth/">観葉植物をまっすぐ育てるコツ</a>を見てみてください
    </li>
    <li>
      <strong>殺虫剤：</strong>
      虫を見つけてから考えれば十分だと私は思います。<a href="/guides/pest-control/">観葉植物の虫対策ガイド</a>にあります
    </li>
  </ul>
  <ul>
    <li>
      <strong>秋冬に迎えたなら：</strong>
      鉢・土・肥料は、生長期（おおよそ5〜9月）に入るまで急がなくて大丈夫です。とくに真冬（12〜2月）の植え替えは避けたいです
    </li>
    <li>
      <strong>春に迎えたなら：</strong>
      迎えて1〜2週間たって、植物が落ち着いてから考えれば十分です
    </li>
  </ul>
  <AmazonLink keyword="霧吹き 園芸 スプレーボトル 葉水" label="Amazonで「葉水用の霧吹き」を見る" />

  <h2>なくても困らないもの（あると便利）</h2>
  <p>
    ここにあるものは、買うなら「困ってからで遅くない」と私は思います。
  </p>
  <ul>
    <li>
      <strong>水分計：</strong>
      指や割り箸で代わりになります。感覚がつかめないうちや、大きい鉢では楽です。
      <a href="/guides/watering/">観葉植物の水やりの頻度と量</a>を見てみてください
    </li>
    <li>
      <strong>温湿度計：</strong>
      季節の変わり目に、数字で分かると安心です。
      <a href="/guides/winter-humidity/">冬の乾燥と部屋の加湿のしかた</a>と
      <a href="/guides/temperature-swings/">寒暖差が激しい時期の守り方</a>にあります
    </li>
    <li>
      <strong>植物育成ライト：</strong>
      明るい窓辺があれば、たぶん要りません。
      <a href="/guides/grow-light/">植物育成ライトの選び方</a>に書いています
    </li>
    <li>
      <strong>サーキュレーター：</strong>
      <a href="/guides/airflow/">風通しのつくり方</a>にまとめています
    </li>
    <li>
      <strong>鉢スタンド：</strong>
      <a href="/guides/display-ideas/">観葉植物の飾り方ガイド</a>を見てみてください
    </li>
  </ul>

  <h2>道具といつ要るかの早見表</h2>
  <p>
    ここまでの道具をまとめて表にしました。
  </p>
  <TableScroll label="道具といつ要るかの早見表">
    <table class="tools-table">
      <thead>
        <tr>
          <th scope="col">道具</th>
          <th scope="col">いつ要るか</th>
          <th scope="col">詳しく書いた記事</th>
        </tr>
      </thead>
      <tbody>
        {TOOLS.map((tool) => (
          <tr>
            <th scope="row">{tool.name}</th>
            <td>{tool.when}</td>
            <td>
              {tool.slugs.map((slug, i) => (
                <>
                  {i > 0 && <br />}
                  <a href={linkOf(slug).href}>{linkOf(slug).label}</a>
                </>
              ))}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </TableScroll>

  <h2>100均で足りる道具</h2>
  <p>
    100均にも観葉植物まわりの道具はひととおりそろっています。
    どこまでが100均で足りて、どこからは別に選びたいかは、
    <a href="/guides/hyakkin-plants/">100均の観葉植物ガイド</a>にまとめました。
    まずは手軽なもので始めてみる、というのも気楽でいいなと私は思います。
  </p>

  <h2>迷ったら診断で</h2>
  <p>
    道具より先に、どの植物を迎えるかで迷っているときは、
    <a href="/#diagnosis">4つの質問の診断</a>で、お部屋の日当たりとお世話の手間から
    合う種類を出してみてください。

  </p>

  <RelatedGuides currentSlug={guide.slug} />

  <BackToDiagnosis />
</BaseLayout>

<style>
  /*
   * 早見表。ほかのガイドの比較表と見た目をそろえている。
   * 和文セルに white-space: nowrap は付けない（SP幅でページごとはみ出す）。
   */
  .tools-table {
    width: 100%;
    margin-bottom: var(--space-2);
    border-collapse: collapse;
    font-size: var(--text-sm);
    text-align: left;
  }
  .tools-table th,
  .tools-table td {
    padding: var(--space-1);
    border-bottom: 1px solid var(--border);
    vertical-align: top;
    font-weight: 400;
  }
  .tools-table thead th {
    color: var(--muted);
    font-weight: 600;
  }
  .tools-table tbody th {
    font-weight: 600;
  }
</style>
