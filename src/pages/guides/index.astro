---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { GUIDES, guidesByCategory, latestGuides } from '../../lib/guides.ts';
import { findPlant } from '../../lib/plants.ts';
import { SITE_URL } from '../../consts.ts';

/**
 * ガイド記事の一覧。植物図鑑（/plants/）が「1種ずつ」なのに対して、こちらは
 * 「虫」「日当たり」「ペット」といった悩みから入る横断記事の入口。
 * カードの中身はビルド時にHTMLへ入る（JSが無効でも全記事に到達できる）。
 */
const title = 'ガイド記事';
const description =
  '初心者がやりがちなNG行動、水やりの頻度と量の決め方、葉が黄色い・茶色いときの原因の見分け方、観葉植物の虫対策、日当たりが悪い部屋でも育つ種類、ペットに安全な植物の選び方、夏越し・冬越しのお手入れ、おしゃれな鉢の選び方、植え替えのタイミングとやり方、肥料の選び方と与え方、挿し木・水挿しでの増やし方、伸びすぎたときの剪定・切り戻し、旅行や帰省で家を空けるときの留守中の水やり対策、土・用土の選び方、買ってきたら最初にやること、土を使わないハイドロカルチャー、部屋がすっきり見える飾り方、根腐れの見分け方と復活のさせ方、葉の斑点や白い粉などの病気の見分け方と対処。悩みごとにまとめた横断ガイド記事の一覧です。';

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'ガイド記事',
  itemListElement: GUIDES.map((guide, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: guide.title,
    url: new URL(`/guides/${guide.slug}/`, SITE_URL).href,
  })),
};

// カテゴリ見出しつきで全19本を表示する（絞り込みはしない。トップと違い1本も削らない）。
const guideGroups = guidesByCategory(GUIDES);

// トップの「新着記事」と同じ3本に「NEW」を付ける（件数方式。vault:
// 1-projects/green-lab/tasks/20260913-add-new-articles-section.md）。
const NEW_GUIDES_COUNT = 3;
const newGuideSlugs = new Set(latestGuides(NEW_GUIDES_COUNT, GUIDES).map((g) => g.slug));
---

<BaseLayout title={title} description={description}>
  <h1>ガイド記事</h1>
  <p class="lead">
    「何をやったら枯れるのか」「水はどれくらいあげればいい」「葉が黄色くなってきた」「虫が出た」「部屋が暗い」「ペットがいる」「夏と冬はどうする」「鉢はどれを選ぶ」「植え替えはいつやる」「肥料はどう与える」「ふやしてみたい」「伸びすぎたけど切っていいの」「旅行のあいだの水やりは」「土は何を使えばいい」「買ってきたら何からすればいい」「土を使わずに育てられないの」「どう飾ればおしゃれに見える」「根腐れかも」「病気かも」——植物選びやお世話でつまずきやすいところを、
    種類をまたいでまとめました。どの一鉢にするか迷ったら、<a href="/#diagnosis">4つの質問の診断</a>からどうぞ。
  </p>

  {guideGroups.map((group) => (
    <section class="guide-category">
      <h2 class="guide-category-title">{group.category.label}</h2>
      <ul class="guide-list">
        {group.guides.map((guide) => (
          <li>
            <article class="guide-card">
              <h3 class="guide-title">
                {newGuideSlugs.has(guide.slug) && <span class="new-flag">NEW</span>}
                <a href={`/guides/${guide.slug}/`}>{guide.title}</a>
              </h3>
              <p class="guide-summary">{guide.summary}</p>
              <p class="guide-plants">
                <span class="guide-plants-label">よく出てくる植物</span>
                {guide.relatedPlants
                  .map((slug) => findPlant(slug))
                  .filter((plant) => plant !== undefined)
                  .map((plant) => plant!.name)
                  .join('・')}
              </p>
            </article>
          </li>
        ))}
      </ul>
    </section>
  ))}

  <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} is:inline />
</BaseLayout>

<style>
  .lead {
    color: var(--muted);
    margin-top: 0;
  }

  /*
   * カテゴリ見出し（.guide-category-title、実体はh2）はBaseLayoutのタイプスケールを
   * そのまま使う（個別のfont-size指定をしない）。カテゴリ間の余白だけ8pxスケール内で
   * var(--space-4)に調整している（h2の既定var(--space-6)は縦に伸びすぎるため）。
   */
  .guide-category + .guide-category {
    margin-top: var(--space-4);
  }
  .guide-category-title {
    margin-top: 0;
  }

  .guide-list {
    display: grid;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .guide-list li {
    margin: 0;
  }

  /* 強調は枠線のみ（枠線＋影の二重使いはしない / design.md） */
  .guide-card {
    height: 100%;
    padding: var(--space-2);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .guide-card:hover {
    border-color: var(--accent);
  }

  .guide-title {
    margin: 0 0 var(--space-1);
    font-size: var(--text-lg);
    line-height: 1.4;
  }
  .guide-title a {
    text-decoration: none;
  }
  .guide-title a:hover {
    text-decoration: underline;
  }

  /*
   * 「NEW」ラベル。.plant-flag（トップの「ペットの誤食に注意」バッジ）と同じ作法
   * （背景色薄・文字色濃・角丸4px・小さめ文字）にとどめ、装飾を足さない
   * （design.mdの「枠線＋影の二重使いはしない」）。色は警告用のvar(--warn)ではなく
   * 補助強調用のvar(--highlight)を使う（新着はセマンティックな警告ではないため）。
   */
  .new-flag {
    display: inline-block;
    margin-right: var(--space-1);
    padding: 0 var(--space-1);
    background: var(--highlight-weak);
    border-radius: 4px;
    color: var(--highlight);
    font-size: var(--text-sm);
    font-weight: 600;
    vertical-align: middle;
  }

  .guide-summary {
    margin: 0 0 var(--space-1);
  }

  .guide-plants {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  .guide-plants-label {
    display: inline-block;
    margin-right: var(--space-1);
    padding: 0 var(--space-1);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-weight: 600;
  }
</style>
