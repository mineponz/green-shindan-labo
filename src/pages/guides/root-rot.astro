---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideArticleHeader from '../../components/GuideArticleHeader.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import AmazonLink from '../../components/AmazonLink.astro';
import BackToDiagnosis from '../../components/BackToDiagnosis.astro';
import { findGuide } from '../../lib/guides.ts';
import { PLANTS, findPlant } from '../../lib/plants.ts';

const guide = findGuide('root-rot')!;

/**
 * 「乾かし気味が正解の種／水を欲しがる種」の分け方は、診断の点数に使っている
 * ease（ズボラ耐性）から描く（記事に手書きすると診断結果・水やりガイドとずれる / AGENTS.md）。
 * しきい値は watering.astro と同じ（ease>=4 / <=3）にそろえている。
 * チランジアは土そのものを使わないので、根腐れという現象自体が起きない。
 * この記事の対象からは除外し、別途1文で触れる（soil.astro と同じ流儀）。
 */
const SOILLESS_SLUGS = ['tillandsia'];
const pottedPlants = PLANTS.filter((plant) => !SOILLESS_SLUGS.includes(plant.slug));
const soillessPlant = findPlant('tillandsia')!;

const dryTolerant = pottedPlants.filter((plant) => plant.attributes.ease >= 4);
const thirsty = pottedPlants.filter((plant) => plant.attributes.ease <= 3);

const nameList = (plants: typeof PLANTS) => plants.map((plant) => plant.name).join('・');
---

<BaseLayout
  title={guide.navLabel}
  description={guide.description}
  breadcrumb={[{ label: 'ガイド記事', href: '/guides/' }]}
  ogImagePath="/og/guide-root-rot.jpg"
>
  <GuideArticleHeader guide={guide} />

  <h2>原因は「水のやりすぎ」だけではありません</h2>
  <p>
    根腐れと聞くと、まず思い浮かぶのは水のやりすぎだと思います。実際そのとおりなのですが、
    私が実際にやらかしたケースを振り返ると、<strong>水の量そのものより「水が抜けない状態」</strong>
    のほうが直接の原因になっていることが多いです。
  </p>
  <ul>
    <li><strong>底穴の無い鉢に直接植えている。</strong> 与えた水の逃げ場が無く、鉢の中にずっと溜まります</li>
    <li>
      <strong>受け皿に溜まった水を放置している。</strong> 底穴があっても、受け皿の水に浸かった
      ままだと同じことになります
    </li>
    <li>
      <strong>水はけの悪い土を使っている。</strong> 安さだけで選んだ培養土が、実は保水に寄りすぎた
      配合だったということがあります
    </li>
    <li>
      <strong>生長が止まっている冬に、夏と同じペースで水をやっている。</strong> 根が水を吸わない
      時期に与え続けると、行き場を失った水が土に残り続けます
    </li>
  </ul>
  <p>
    共通しているのは、<strong>「土が湿った状態が長く続く」</strong>という結果です。
    水やりの回数を減らす前に、まずこの4つのどれかに心当たりが無いか確認してみてください。
  </p>
  <p class="note">
    鉢底の穴・鉢カバーの使い方は<a href="/guides/pot-guide/">おしゃれな鉢・プランターの選び方</a>に、
    土の配合は<a href="/guides/soil/">観葉植物の土・用土選び</a>に、冬の水やりの間隔は
    <a href="/guides/seasonal-care/">夏越し・冬越しのお手入れガイド</a>にまとめています。
  </p>

  <h2>地上部に出るサイン</h2>
  <p>
    根腐れは土の中で進むので、最初は気づきにくいのが厄介なところです。
    ただ、次のようなサインが重なって出てきたら、鉢の中を疑ったほうがいいです。
  </p>
  <ul>
    <li><strong>下葉から黄色くなる。</strong> それも1〜2枚ではなく、次々にという勢いのとき</li>
    <li>
      <strong>株元がぐらつく。</strong> 触ってみて、根元がしっかり土をつかんでいる感触が無い
    </li>
    <li>
      <strong>土がいつまでも湿っている。</strong> 前に水をやってからかなり経つのに、
      表面がずっとしっとりしたまま
    </li>
    <li><strong>土の表面に白いカビのようなものが出る。</strong> 過湿のサインです</li>
    <li>
      <strong>においが変わる。</strong> 土から酸っぱいような、どぶのようなにおいがしてきたら、
      これはかなり進んでいます
    </li>
  </ul>
  <p>
    私が最初に気づいたのは、株元をつかんだときに「あれ、こんなに柔らかかったっけ」と思った瞬間でした。
    見た目より先に、触った感触で分かることも多いです。
  </p>

  <h2>確定は、鉢から抜いて根を見るしかありません</h2>
  <p>
    地上部のサインはあくまで「疑う」ところまでです。<strong>確定させるには、鉢から抜いて根を
    直接見るしかありません。</strong>まわりくどいようですが、ここを飛ばして水やりを増減しても
    的外れになりがちです。
  </p>
  <ul>
    <li>
      <strong>健康な根。</strong> 白っぽくて、指でつまむと張りがあります。においもありません
    </li>
    <li>
      <strong>腐った根。</strong> 黒っぽく変色してドロッとしています。指でつまむと表面の皮だけが
      するりと剥けて、中の芯が抜け落ちる。土のような、あるいはどぶのようなにおいが出ていることが
      多いです
    </li>
  </ul>
  <p>
    私は最初にこれをやったとき、根を触った瞬間の感触に思わず声が出ました。
    見た目だけでは判断がつかない株ほど、指でつまんでみるとはっきり分かります。
  </p>

  <h2>復活の手順</h2>
  <p>
    腐った根が見つかっても、<strong>すべての根が黒くなっていなければ、まだ間に合います。</strong>
    ここからは実際に私がやっている手順です。
  </p>
  <ol>
    <li>
      <strong>傷んだ根を切る。</strong> 黒くドロッとした部分を、健康な白い根が見えるところまで
      清潔なハサミで切り戻します。迷ったところは思い切って切ったほうが、あとで悔やまずに済みます
    </li>
    <li>
      <strong>切り口を乾かす。</strong> 切ったらすぐに植えず、風通しのいい日陰で数時間〜半日ほど
      置いて切り口を乾かします。濡れたまま土に戻すと、そこからまた傷みやすいです
    </li>
    <li>
      <strong>ひと回り小さい鉢と、乾いた新しい土に浅く植える。</strong> 根を減らしたぶん、鉢も
      減らすのがポイントです。前より大きい鉢に植えると、根が届かない土がまた湿ったままになって
      逆戻りします。土は湿らせず、乾いた状態のものを使ってください
    </li>
    <li>
      <strong>水はすぐにやらない。</strong> 植えた直後にたっぷりやりたくなりますが、ここはこらえて
      ください。数日待って、土の表面が乾いているのを確認してから最初の水をやります
    </li>
    <li>
      <strong>明るい日陰で2週間ほど養生する。</strong> 直射日光を避け、根が落ち着くまでそっとして
      おきます。この間に新しい葉が動き出せば、回復のサインです
    </li>
    <li>
      <strong>肥料は絶対に足さない。</strong> 弱っている株に肥料を与えるのは、追い打ちをかける
      だけです。傷んだ根は濃い肥料分に耐えられません。再開は新芽が動いて根が落ち着いてから、
      <a href="/guides/fertilizer/">肥料ガイド</a>を見ながらにしてください
    </li>
  </ol>
  <AmazonLink keyword="剪定バサミ 園芸 ハサミ" label="Amazonで「剪定バサミ」を見る" />
  <AmazonLink keyword="観葉植物 培養土 室内 土" label="Amazonで「観葉植物用培養土」を見る" />
  <AmazonLink keyword="植木鉢 観葉植物 おしゃれ" label="Amazonで「植木鉢」を見る" />

  <h2>{pottedPlants.length}種でみる、乾かし気味が正解の種・水を欲しがる種</h2>
  <p>
    根腐れのなりやすさは、診断の点数に使っている<strong>ズボラ耐性</strong>
    （大きいほど水やりを忘れても枯れにくい＝乾かし気味を好む）とほぼ重なります。
  </p>
  <p>
    {nameList(dryTolerant)}は、そもそも乾いた環境を好む側。
    「元気がないから」と水を足したくなる場面ほど、この子たちにとっては逆効果になりがちです。
    反対に{nameList(thirsty)}は、乾いたら早めに水をあげたい側で、
    これらは根腐れよりむしろ水切れのほうに気をつけたい相手です。
    ただしどちらのグループでも、土が湿ったままの状態が続けば根腐れは起こります。
    「この種は根腐れしにくい」という意味ではなく、あくまで水やりの間隔の目安として見てください。
  </p>
  <p class="note">
    {soillessPlant.name}は土を使わずに育てる種類なので、
    この章の対象からは外しています。濡れたまま風通しの悪い場所に置きっぱなしにすると、
    株の中心から腐ることはあるので、水やり後はしっかり乾かす必要がある点だけは共通です。
  </p>

  <h2>どこからが手遅れか</h2>
  <p>
    正直に言うと、<strong>株元まで真っ黒でぶよぶよになっていたら、その株はもう戻りません。</strong>
    根がすべて機能を失っている状態から、切り戻しだけで立て直すのは難しいです。
  </p>
  <p>
    ただ、それで諦めなくていい場合もあります。<strong>上のほうの茎や葉がまだしっかりしているなら、
    その部分だけ切り取って挿し木にすれば、株そのものは残せます。</strong>
    根が全滅していても、茎から新しい根を出させる方法です。私も一度、株元が完全にダメになった
    株の上半分だけを水挿しにして、そのまま新しい株として育て直したことがあります。
  </p>
  <p class="note">
    挿し木・水挿しのやり方は<a href="/guides/propagation/">観葉植物の増やし方ガイド</a>に
    まとめています。「もうダメかも」と思ったときほど、捨てる前にいちど試してみてください。
  </p>

  <h2>再発させないための置き場所と鉢</h2>
  <p>
    せっかく立て直しても、環境を変えなければまた同じことが起きます。
    <strong>置き場所と鉢を、根腐れさせにくい形に整えておく</strong>のが最後の仕上げです。
  </p>
  <p>
    置き場所は、風通しがあって土が適度に乾く場所を選んでください。
    締め切った部屋の隅や、エアコンの風が当たらない代わりに空気もこもる場所は、
    土が乾くのに時間がかかります。水やりの間隔・見極め方は
    <a href="/guides/watering/">観葉植物の水やりの頻度と量</a>に詳しくまとめました。
  </p>
  <p>
    鉢は、必ず底穴のあるものを。気に入った鉢に穴が無い場合は、鉢カバーとして使う手もあります。
    そして今の株に対して鉢が大きすぎないかも、この機会に見直してみてください。
    植え替えのタイミングと手順は<a href="/guides/repotting/">観葉植物の植え替え、タイミングと
    やり方</a>にまとめています。
  </p>

  <RelatedGuides currentSlug={guide.slug} />

  <BackToDiagnosis />
</BaseLayout>

<style>
  /* 補足は本文より一段弱く（色を足さずミュートで後退させる / design.md） */
  .note {
    color: var(--muted);
    font-size: var(--text-sm);
  }
</style>
