---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideArticleHeader from '../../components/GuideArticleHeader.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import AmazonLink from '../../components/AmazonLink.astro';
import BackToDiagnosis from '../../components/BackToDiagnosis.astro';
import { findGuide } from '../../lib/guides.ts';
import { PLANTS } from '../../lib/plants.ts';

const guide = findGuide('plant-diseases')!;

/**
 * 「虫がつきやすい＝すす病に注意したい種」の分け方は、診断の点数に使っている
 * attributes.pest（虫のつきにくさ。大きいほどつきにくい）から描く
 * （記事に数字を手書きすると診断結果・虫対策ガイドとずれる / AGENTS.md）。
 * すす病の原因はカイガラムシ・アブラムシなど虫の排せつ物なので、虫がつきやすい
 * （pestが低い）種ほどすす病のきっかけも増える、という向きで一般化している。
 */
const pestProne = PLANTS.filter((plant) => plant.attributes.pest <= 3);

const nameList = (plants: typeof PLANTS) => plants.map((plant) => plant.name).join('・');
---

<BaseLayout
  title={guide.navLabel}
  description={guide.description}
  breadcrumb={[{ label: 'ガイド記事', href: '/guides/' }]}
  ogImagePath="/og/guide-plant-diseases.jpg"
>
  <GuideArticleHeader guide={guide} />

  <h2>虫でも水でもないときに、菌を疑う</h2>
  <p>
    葉に何か異変が出たとき、まず疑うべきは水やりと虫です。
    観葉植物のトラブルの多くは、正直このどちらかで説明がついてしまいます。
  </p>
  <ul>
    <li>
      黄色い・茶色い・垂れる・落ちるといった症状は、まず
      <a href="/guides/leaf-problems/">葉の症状から原因を見分けるガイド</a>で水やりや
      置き場所の問題かどうかを確認してください
    </li>
    <li>
      白いかすれ・べたつき・貝殻のようなものが見えたら、
      <a href="/guides/pest-control/">観葉植物の虫対策ガイド</a>のほうが先です
    </li>
  </ul>
  <p>
    そのうえで、<strong>斑点が広がる・白い粉をふく・すすけたように黒くなる</strong>——
    こういう出方をしていて、水やりも虫も心当たりが無いなら、ここでようやく菌による病気の出番です。
    私はこれを見分けられず、しばらく虫を探し回って無駄に時間を使ったことがあります。
    「入口はいつもの2つのままでいい」ということだけ覚えておいて、
    それでも当てはまらないときにこのページに戻ってきてください。
  </p>

  <h2>白い粉をふく — うどんこ病</h2>
  <p>
    葉の表面に、まるで小麦粉をまぶしたような<strong>白い粉状のもの</strong>が広がっていたら、
    うどんこ病です。カビの一種で、名前のとおり見た目にとても分かりやすい病気です。
  </p>
  <p>
    <strong>乾燥していて、なおかつ風通しの悪い環境</strong>で発生しやすいのが特徴です。
    「乾燥するとカビが生えるなんて」と私は最初意外に思ったのですが、
    水はけの悪さで起きる根腐れとは別の話だと考えるとしっくりきます。
  </p>
  <p>
    やっかいなのは、<strong>葉を拭き取るだけでは戻らない</strong>ことです。
    見た目の粉は取れても、菌自体は葉の内部まで入り込んでいます。
    症状が出た葉は思い切って取り除き、株全体の風通しを良くすることでこれ以上の広がりを防ぎます。
    数が多い、あるいは繰り返す場合は、園芸用の殺菌剤で対処してください。
  </p>
  <AmazonLink keyword="園芸用 殺菌剤 うどんこ病" label="Amazonで「園芸用の殺菌剤」を見る" />

  <h2>黒くすすける — すす病</h2>
  <p>
    葉や茎が、まるで<strong>すすが付いたように黒く</strong>なってきたら、すす病を疑ってください。
    見た目はいちばんぎょっとする病気かもしれません。私も最初はホコリか汚れかと思って拭こうとしました。
  </p>
  <p>
    ただ、この病気には<strong>ほかの2つと違う特徴</strong>があります。
    すす病自体の原因はカビなのですが、そのカビは<strong>虫の排せつ物（甘露）</strong>を栄養にして
    増えます。つまり、<strong>黒いすすを見つけたら、まずその株に虫がついていないかを疑う</strong>
    のが正しい順番です。すすだけを拭き取っても、元の虫を放っておけばまた同じことの繰り返しになります。
  </p>
  <p class="note">
    カイガラムシ・アブラムシなど、甘露を出す虫の見分け方と対処は
    <a href="/guides/pest-control/">観葉植物の虫対策ガイド</a>に詳しくまとめています。
    すすけた葉を見つけたら、まずそちらを一周してから戻ってきてください。
  </p>

  <h2>茶色〜黒の斑点が広がる — 斑点病・炭疽病</h2>
  <p>
    葉のあちこちに<strong>茶色や黒の斑点</strong>ができて、それが少しずつ広がっていく。
    こういう出方をするのが斑点病や炭疽病です。
    最初は小さな点なので見逃しがちですが、放っておくと斑点同士がつながって、
    葉全体が枯れ込んでしまうこともあります。
  </p>
  <p>
    対処の基本は<strong>切除と隔離</strong>です。斑点の出た葉は、広がりきる前に葉ごと切り落として
    しまってください。「もったいない」と残しておくと、そこから胞子が飛んで隣の葉や
    近くに置いてある別の株にまで移ることがあります。切った葉はゴミとして処分し、
    土の上に落としたままにしないでください。
  </p>
  <p>
    症状が出た株は、しばらく他の株から少し離しておくとより安心です。
    水やりのときに葉から葉へ水が飛び散ることでも広がるので、
    上から勢いよく水をかけるような与え方は避けたほうがいいです。
  </p>

  <h2>共通の対処と、やってはいけないこと</h2>
  <p>
    3つとも原因の菌は違いますが、<strong>やるべきことはかなり共通しています。</strong>
  </p>
  <ul>
    <li><strong>傷んだ葉は早めに切る。</strong> 治る病気ではないので、戻すより減らす発想で構いません</li>
    <li>
      <strong>風通しを作る。</strong> 葉が込み合って蒸れている株は、それだけで発症しやすくなります。
      伸びすぎて葉が重なっている場合は
      <a href="/guides/pruning/">剪定・切り戻し</a>で間引いてあげてください
    </li>
    <li>
      <strong>濡れたまま放置しない。</strong> 葉水のあとや雨に当たったあとは、
      風通しのいい場所で乾かしてください。湿ったままの葉は菌にとって好都合な環境です
    </li>
  </ul>
  <p>
    逆に、私が実際にやってしまって良くなかったのが<strong>「とりあえず葉を拭けば治る」</strong>と
    思い込んだことです。うどんこ病もすす病も、表面を拭くだけでは元を断てません。
    見た目がきれいになっても、風通しや虫の対処をしなければまた同じ場所に出てきます。
  </p>

  <h2>{PLANTS.length}種でみる、虫がつきやすい＝すす病に注意したい種</h2>
  <p>
    病気になりやすいかどうかを示すデータはこのサイトに無いのですが、
    <strong>すす病だけは虫のつきやすさと直結している</strong>ので、
    診断の点数に使っている<strong>虫のつきにくさ</strong>（小さいほど虫がつきやすい）から
    ある程度見分けがつきます。
  </p>
  <p>
    {nameList(pestProne)}は、8種のなかで虫がつきやすいほう。
    虫がつくということは、その排せつ物を栄養にするすす病のきっかけも増えるということです。
    うどんこ病・斑点病はどの種でも条件が揃えば起こりうるので、
    この表はあくまで<strong>すす病だけ</strong>の話として見てください。
  </p>
  <p class="note">
    虫そのものの見分け方・対処は<a href="/guides/pest-control/">観葉植物の虫対策ガイド</a>に、
    種ごとの虫のつきにくさの詳しい比較もそちらの記事にまとめています。
  </p>

  <RelatedGuides currentSlug={guide.slug} />

  <BackToDiagnosis />
</BaseLayout>

<style>
  /* 補足は本文より一段弱く（色を足さずミュートで後退させる / design.md） */
  .note {
    color: var(--muted);
    font-size: var(--text-sm);
  }
</style>
