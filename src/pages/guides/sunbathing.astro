---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideArticleHeader from '../../components/GuideArticleHeader.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import AmazonLink from '../../components/AmazonLink.astro';
import BackToDiagnosis from '../../components/BackToDiagnosis.astro';
import TableScroll from '../../components/TableScroll.astro';
import { findGuide } from '../../lib/guides.ts';
import { PLANTS } from '../../lib/plants.ts';

const guide = findGuide('sunbathing')!;

/**
 * 早見表の「ひとこと」。plants.ts の各植物の説明と、既存ガイド（seasonal-care・low-light-plants・
 * bring-indoors・rainy-days）に書いてある範囲だけを使う（新しい事実を足さない /
 * vault: 1-projects/green-lab/tasks/20261008-add-autumn-sunny-two-guides.md）。
 * 植物名・リンク・並び順・種数は plants.ts の sun から描き、手書きしない。
 * 気温の数値はこの記事に書かない（種類ごとの目安は bring-indoors の早見表に任せる）。
 */
const SUN_NOTES: Record<string, string> = {
  pachira: '明るい日陰でよく育つ種類。夏の直射日光では葉焼けするので、レースカーテン越しくらいがちょうどいいです',
  monstera: 'もともと直射日光が苦手で、明るい日陰がちょうどいい植物です',
  sansevieria: '耐陰性もありますが、本来は日光が大好きな植物です',
  pothos: '8種のなかでいちばん暗い場所に強く、季節の光量の変化にも動じにくいタイプです',
  gajumaru: '日光が大好きで、日当たりのよい窓ぎわが得意です。日照不足になると葉を落とすことがあります',
  'areca-palm': '明るさを欲しがる種類。ただ乾燥には弱いので、様子を見ながら',
  peperomia: '直射日光が苦手で、夏の窓ぎわに出すと葉が白く抜けることがあります',
  tillandsia: '土がないぶん、季節の差が「乾くまでの時間」に出ます。外に出した日は乾き具合を見てあげてください',
};

/** sun の値から3段階のラベルを出す */
function sunLabel(sun: number): string {
  if (sun >= 4) return '日ざしが好き';
  if (sun === 3) return 'ほどほど';
  return 'やわらかい光が好き';
}

/** 日ざしに強い順（同じ値は plants.ts の掲載順を保つ） */
const sunSorted = [...PLANTS].sort((a, b) => b.attributes.sun - a.attributes.sun);
---

<BaseLayout
  title={guide.navLabel}
  description={guide.description}
  breadcrumb={[{ label: 'ガイド記事', href: '/guides/' }]}
  ogImagePath="/og/guide-sunbathing.jpg"
>
  <GuideArticleHeader guide={guide} />

  <h2>秋晴れの日は、鉢を外に出していい？</h2>
  <p>
    空がすっきり晴れた秋の朝は、「今日は鉢を外に出してあげようかな」と私はつい思ってしまいます。
    窓ぎわで静かにしている姿を見ると、風や日ざしを分けてあげたくなりますよね。
  </p>
  <p>
    先に結論を言うと、出して大丈夫です。ただし守ってほしいのは、
    <strong>いきなり直射日光に出さないこと</strong>と、
    <strong>夜は出しっぱなしにしないこと</strong>の2つだけ。
    この2つさえ押さえておけば、秋はいちばん気楽に日光浴をさせてあげられる季節だと私は思います。
  </p>

  <h2>日に当てると何がいいの？</h2>
  <p>
    光が足りないと、枝や茎がひょろひょろと間延びする「徒長」が起きることがあります。
    部屋の奥で光が足りていない株にとって、外や窓辺の光は、部屋の中よりずっと明るいはず。
    うれしい時間になるんじゃないかな、と私は思っています。
    暗い場所での育ち方は
    <a href="/guides/low-light-plants/">日当たりが悪い部屋でも育つ観葉植物</a>に、
    光を補う方法は<a href="/guides/grow-light/">植物育成ライトの選び方</a>にまとめています。
  </p>
  <p>
    反対に、ふだんから十分に明るい窓ぎわに置けている株は、無理に外へ出さなくて大丈夫です。
    「出さなきゃ」と気負うより、「晴れたし、出してみようかな」くらいの気分がちょうどいいと思います。
  </p>

  <h2>いきなり直射日光に出さない（慣らし方）</h2>
  <p>
    室内の光に慣れた葉を急に強い光へ出すと、葉焼けします。
    焼けた部分は、もう元の緑には戻りません。
    つやつやの葉が白っぽく抜けてしまうと、見るたびに落ち込むので、ここは慎重にいきたいところです。
    このあたりは<a href="/guides/beginner-mistakes/">初心者がやりがちなNG行動</a>も読んでみてください。
  </p>
  <p>進め方は、こんなイメージです。</p>
  <ul>
    <li>
      <strong>まずは日陰から。</strong>
      日陰、屋根のあるベランダ、レースカーテン越しなど、部屋の明るさに近い場所に出します
    </li>
    <li>
      <strong>短い時間だけ出して、戻す。</strong>
      これを繰り返しながら、何日かかけて少しずつ時間をのばしていきます
    </li>
    <li>
      <strong>葉の色を見る。</strong>
      葉が白っぽく抜けたり、茶色くなりそうな気配があれば、すぐ日陰に移してあげてください。
      見分け方は<a href="/guides/leaf-problems/">葉の症状から原因を見分ける</a>にあります
    </li>
  </ul>
  <p>
    焦らなくていい作業なので、「今日はここまで」と区切りながら、植物のペースに合わせてあげましょう。
  </p>

  <h2>時間帯と置き場所</h2>
  <p>
    私なら、午前中のやわらかい日差しから始めます。午前の光は穏やかなので、
    慣れていない葉にも当てやすいと感じるからです。
  </p>
  <p>
    一方、午後の西日は強く当たりやすいので、慣れるまでは避けておくと安心です。
    置き場所は、まず頭の上に屋根や軒がある場所か、建物の影になる場所を選んで、
    そこから少しずつ日の当たる側に近づけていくと、植物もびっくりしません。
  </p>

  <h2>月で変わること</h2>
  <p>
    同じ「秋」でも、9月と11月では事情がずいぶん違います。月ごとに、気をつけたいことを並べました。
    何度になったら部屋へ戻すかは種類によって違うので、
    <a href="/guides/bring-indoors/">秋の取り込みのタイミングと手順</a>の早見表で確かめてください。
  </p>
  <ul>
    <li>
      <strong>9月：</strong>
      まだ日差しが強い日があります。そういう日は、夏と同じつもりで直射を避けてください。
      夏の葉焼けのことは<a href="/guides/seasonal-care/">観葉植物の夏越し・冬越しガイド</a>に書いています
    </li>
    <li>
      <strong>10月：</strong>
      いちばんやりやすい時期です。ただ、朝晩の気温が下がりはじめるので、夜は部屋に戻してあげてください
    </li>
    <li>
      <strong>11月：</strong>
      日中あたたかい日だけ、短い時間で。主役は日ざしより、冷え込みへの注意に変わります。
      この時期は外に出すより、窓ぎわの明るさを活かすほうを私ならおすすめします
    </li>
  </ul>

  <h2>夜は部屋に戻す</h2>
  <p>
    日が傾いたら、鉢は部屋に戻します。出しっぱなしにしないというのが、この記事の2つ目の約束でした。
    とはいえ、戻し忘れてしまう日って、ありますよね。そこで、忘れにくくする工夫を挙げてみます。
  </p>
  <ul>
    <li>出すのは、家にいる休日だけにする</li>
    <li>スマホのアラームをかけておく</li>
    <li>キャスター付きの鉢スタンドに載せておく（出し入れが楽になるので、戻すのが億劫になりにくいと私は思います）</li>
  </ul>
  <AmazonLink keyword="鉢スタンド キャスター付き 観葉植物" label="Amazonで「キャスター付きの鉢スタンド」を見る" />
  <p>
    外に出した鉢は、気づかないうちに虫が付いていることがあります。
    戻す前に、葉の裏・土の表面・鉢底をさっと見てあげてください。
    手順は<a href="/guides/bring-indoors/">秋の取り込みのタイミングと手順</a>の「戻す前にやる3つ」に、
    虫の見分け方や対処は<a href="/guides/pest-control/">観葉植物の虫対策ガイド</a>にまとめています。
  </p>

  <h2>{PLANTS.length}種でみる、日ざしとの付き合い方</h2>
  <p>
    このサイトで診断に使っている{PLANTS.length}種を、日ざしを好む順に並べました。
    「日ざしが好き」と書いてある組でも、部屋で育ってきた株は、いきなりの直射で焼けることがあります。
    なので慣らし方は、どの種類でも同じです。
    また、真夏のような強い日差しの日は、この組でも直射は避けたほうが安心です。
  </p>
  <TableScroll label={`${PLANTS.length}種の日ざしとの付き合い方の早見表`}>
    <table class="sunbathing-table">
      <thead>
        <tr>
          <th scope="col">植物</th>
          <th scope="col">日ざしの好み</th>
          <th scope="col">ひとこと</th>
        </tr>
      </thead>
      <tbody>
        {sunSorted.map((plant) => (
          <tr>
            <th scope="row"><a href={`/plants/${plant.slug}/`}>{plant.name}</a></th>
            <td>{sunLabel(plant.attributes.sun)}</td>
            <td>{SUN_NOTES[plant.slug]}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </TableScroll>
  <p>
    「やわらかい光が好き」な組は、外に出すにしても明るい日陰までにしておくのがいいと私は思います。
  </p>
  <p>
    それから、<a href="/plants/tillandsia/">チランジア（エアプランツ）</a>は土がないぶん乾きやすいので、
    外に出した日は、いつもより様子を見てあげてください。
  </p>

  <h2>外に出せないときは</h2>
  <p>
    ベランダが無い、出す場所が無い、という方も多いと思います。
    そんなときは、窓を開けた窓辺や、レースカーテン越しの窓ぎわでも、
    植物にとっては十分うれしい時間になると私は思っています。
    無理に外へ出さなくて大丈夫です。
  </p>
  <p>
    どうしても暗い部屋なら、
    <a href="/guides/grow-light/">植物育成ライトの選び方</a>で光を補う方法を見てみてください。
    そして日光と一緒に、風も通してあげたいところ。
    <a href="/guides/airflow/">風通しのつくり方</a>に、その方法を書いています。
  </p>
  <AmazonLink keyword="植物育成ライト 観葉植物" label="Amazonで「植物育成ライト」を見る" />

  <h2>迷ったら診断で</h2>
  <p>
    日ざしの強さや置き場所は、お部屋によってずいぶん違います。
    <a href="/#diagnosis">4つの質問の診断</a>では、お部屋の日当たりとお世話の手間から
    合う種類を出せるので、次に迎える一鉢の参考にしてみてください。
  </p>

  <RelatedGuides currentSlug={guide.slug} />

  <BackToDiagnosis />
</BaseLayout>

<style>
  /*
   * 早見表。ほかのガイドの比較表と見た目をそろえている
   * （横罫だけ・囲みの重さを出さない / design.md）。
   * 和文セルに white-space: nowrap は付けない（SP幅でページごとはみ出す /
   * 3-resources/knowledge/20260920-ja-table-nowrap-breaks-sp.md）。
   */
  .sunbathing-table {
    width: 100%;
    margin-bottom: var(--space-2);
    border-collapse: collapse;
    font-size: var(--text-sm);
    text-align: left;
  }
  .sunbathing-table th,
  .sunbathing-table td {
    padding: var(--space-1);
    border-bottom: 1px solid var(--border);
    vertical-align: top;
    font-weight: 400;
  }
  .sunbathing-table thead th {
    color: var(--muted);
    font-weight: 600;
  }
  .sunbathing-table tbody th {
    font-weight: 600;
  }
</style>
