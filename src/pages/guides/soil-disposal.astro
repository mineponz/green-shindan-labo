---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideArticleHeader from '../../components/GuideArticleHeader.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import AmazonLink from '../../components/AmazonLink.astro';
import BackToDiagnosis from '../../components/BackToDiagnosis.astro';
import TableScroll from '../../components/TableScroll.astro';
import { findGuide } from '../../lib/guides.ts';

const guide = findGuide('soil-disposal')!;

/**
 * 捨て方の早見表。本文に書いた範囲だけを使う
 * （自治体の区分・量の目安・料金は書かない / vault: 1-projects/green-lab/notes/20261003-fact-check-long-weekend-and-two-guides.md 記事A）。
 */
const DISPOSAL_OPTIONS = [
  {
    method: '自治体のごみとして出す',
    when: '自治体の分別一覧に「土」が載っていて、少量なら出せるとき',
    caution: '量の目安も出し方も自治体ごとに違います。捨てる前に公式サイトで確認します',
  },
  {
    method: 'ホームセンターの回収',
    when: 'お住まいの近くに回収を行っている店舗があるとき',
    caution: '実施している店舗も期間も限られます。会員登録が要る場合があり、用土のみで鉢底石や根は取り除きます',
  },
  {
    method: '専門業者に頼む',
    when: '自治体で収集してもらえないとき・量が多いとき',
    caution: '料金や対応は業者ごとに違うので、依頼する前に確かめます',
  },
  {
    method: '購入したお店に相談する',
    when: '植物や土を買ったお店が近くにあるとき',
    caution: '対応はお店次第です。まず聞いてみる、という位置づけです',
  },
  {
    method: '再生して使う',
    when: '病気や虫が出ていない土を、また使いたいとき',
    caution: '根やゴミを除き、ふるい・日光消毒・再生材の混ぜ込みをします。病気や虫が出た土は処分に回します',
  },
];
---

<BaseLayout
  title={guide.navLabel}
  description={guide.description}
  breadcrumb={[{ label: 'ガイド記事', href: '/guides/' }]}
  ogImagePath="/og/guide-soil-disposal.jpg"
>
  <GuideArticleHeader guide={guide} />

  <h2>古い土は、住んでいる場所で捨て方が変わる</h2>
  <p>
    植え替えのあとの古い土って、「どこに出せばいいの？」と手が止まりがちですよね。
    袋に詰めたはいいけれど、そのまま置きっぱなしになっている、という方も多いと思います。
  </p>
  <p>
    ややこしいのは、土の扱いがお住まいの自治体によって変わることです。
    ここでは考え方と確かめ方をまとめますが、最後に頼りになるのは自治体の案内なので、
    そこだけは先にお伝えしておきます。
  </p>

  <h2>まず自治体のルールを確かめる</h2>
  <p>
    大きく分けると、自治体のルールには2つのパターンがあります。
  </p>
  <ul>
    <li>
      <strong>自治体では収集しない</strong>。専門業者などに頼んでください、という案内になる
    </li>
    <li>
      <strong>少量ならごみとして出せる</strong>。出し方や量には決まりがある
    </li>
  </ul>
  <p>
    具体例を2つだけ挙げます（いずれも2026年10月時点で、自治体の公式ページで確認した内容です）。
    東京都杉並区は、品目「土」について「区では収集できません」「専門業者に処理を依頼してください。」
    と案内しています。いっぽう横浜市は、「一度に多量にならないよう少量ずつ」、
    「燃えないごみ」の収集日に「透明または半透明の袋に入れて」出す、という案内です。
    同じ「土」でも、こんなに違うんですね。
  </p>
  <p>
    「少量」がどのくらいの量を指すのかも、自治体ごとに違います。
    となりの市の話がそのまま当てはまるとは限らないので、私なら思い込みで出さずに、次の順で確かめます。
  </p>
  <ol>
    <li>「お住まいの自治体名 土 ごみ」などで検索し、<strong>自治体の公式サイトの分別一覧</strong>を見る</li>
    <li>載っていなければ、清掃事務所などの窓口に聞いてみる</li>
  </ol>
  <p>
    ルールは変わることがあります。捨てる前に、そのときの案内を確認してください。
  </p>

  <h2>回収してもらえないときの選択肢</h2>
  <p>
    自治体で収集してもらえないとなると、ちょっと気が重いですよね。そんなときの選択肢は3つあります。
  </p>
  <h3>ホームセンターの回収</h3>
  <p>
    ホームセンターによっては、土の回収を行っているところがあります。たとえばカインズは、
    一部の店舗で、自治体と連携して家庭の園芸用土の無料回収を行っています。
    利用には会員登録（無料）が必要で、回収してもらえるのは用土のみです。
    鉢底石や根などは取り除いて持ち込みます。回収した土は、焼成・殺菌を経て
    再生培養土になる、とされています。
  </p>
  <p>
    ただし、<strong>実施している店舗も期間も限られています</strong>。
    行ってから「やっていなかった」とならないよう、お店の公式情報で確認してから出かけてください。
  </p>
  <h3>専門業者に頼む</h3>
  <p>
    土の回収・処分を請け負う専門業者に頼む方法もあります。料金や対応は業者ごとに違うので、
    依頼する前に内容を確かめてください。
  </p>
  <h3>購入したお店に相談する</h3>
  <p>
    植物や土を買ったお店に相談してみる、という手もあります。対応はお店次第ですが、
    聞いてみて損はないと私は思います。
  </p>

  <h2>やってはいけない捨て方</h2>
  <p>
    いちばん避けたいのは、公園・山・河川敷・空き地などに捨ててしまうことです。
    これは不法投棄にあたり、法律で禁じられていて、罰則もあります。
  </p>
  <p>
    「土は自然のものだから、戻すだけ」と考えたくなる気持ちは分かります。
    ただ、鉢から出した土には古い根や肥料分が混ざっていて、公園や山にもともとある土と同じものではありません。
    困っているときほど魔が差しやすいので、ここだけは気をつけてほしいなと思います。
  </p>

  <h2>捨てずに再生して使う</h2>
  <p>
    ここまで捨て方を見てきましたが、捨てずに使うという道もあります。
    <a href="/guides/soil/">観葉植物の土ガイド</a>では、古い土を<strong>そのまま</strong>使い回さないようにお伝えしています。
    ここで書くのは、手を入れてから使う話です。基本の手順は次のとおりです。
  </p>
  <ol>
    <li>根やゴミを取り除く</li>
    <li>ふるいにかけて、細かすぎる粒（微塵）を除く</li>
    <li>黒いビニール袋に入れて日光に当て、消毒する</li>
    <li>土の再生材（リサイクル材）を混ぜる</li>
  </ol>
  <p>
    日光消毒の期間は、解説によって幅があります。夏で数日〜2週間ほど、
    涼しい時期はもっと長く、と説明されていて、気温や天候によっても変わります。
    「何日で終わり」と決めつけず、余裕をもって進めるのがよさそうです。
  </p>
  <p>
    再生材を混ぜる割合も、製品によって違います。古い土8：再生材2から、4：1くらいまで
    幅があるので、お使いの製品の袋の表示に従ってください。
  </p>
  <AmazonLink keyword="古い土の再生材 園芸用" label="Amazonで「土の再生材」を見る" />
  <AmazonLink keyword="園芸用 ふるい 土ふるい" label="Amazonで「園芸用のふるい」を見る" />
  <AmazonLink keyword="園芸シート 作業用 ガーデニング" label="Amazonで「園芸シート」を見る" />
  <p>
    ただし、病気や虫が出た土は再利用せず、処分に回すのが基本です。
    私なら、少しでも不安のある土は無理に使わないと思います。
    病気については<a href="/guides/plant-diseases/">観葉植物の病気ガイド</a>も参考にしてください。
  </p>

  <h2>捨て方の選択肢 早見表</h2>
  <TableScroll label="捨て方の選択肢の早見表">
    <table class="soil-disposal-table">
      <thead>
        <tr>
          <th scope="col">方法</th>
          <th scope="col">向いている場面</th>
          <th scope="col">気をつけること</th>
        </tr>
      </thead>
      <tbody>
        {DISPOSAL_OPTIONS.map((option) => (
          <tr>
            <th scope="row">{option.method}</th>
            <td>{option.when}</td>
            <td>{option.caution}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </TableScroll>

  <h2>枯れた植物・鉢・鉢底石の分け方</h2>
  <p>
    土のほかにも、枯れた枝葉や根、鉢（プラスチック・陶器・素焼き）、鉢底石、支柱が出ます。
    これらの区分も自治体で違います。
  </p>
  <p>
    一般的には、鉢は土を落としてから出すこと、素材や大きさで区分が変わることが多いようです。
    具体的にどのごみになるかは、自治体の分別一覧で確かめてください。
  </p>
  <p>
    まだ元気な株を手放すだけなら、捨てる前に譲るという手もあります。知人に声をかけたり、
    フリマアプリや地域の掲示板に出したりする方法です。私は、元気な株が誰かのところで育つなら、
    それがいちばん気持ちが楽だなと思います。
  </p>
  <p>
    根腐れした鉢を片付けるときは、<a href="/guides/root-rot/">根腐れの見分け方と対処</a>も読んでみてください。
  </p>

  <h2>そもそも土のゴミを減らすには</h2>
  <p>
    土の始末で悩むのは、土を使うからこそです。減らす方法もいくつかあります。
  </p>
  <ul>
    <li>
      土を使わない育て方にする。<a href="/guides/hydroculture/">ハイドロカルチャーのガイド</a>で紹介しています
    </li>
    <li>
      小さな鉢から始める。<a href="/guides/hyakkin-plants/">100均の観葉植物ガイド</a>が参考になります
    </li>
    <li>
      植え替えの回数を増やしすぎない。目安は2〜3年に1回で、サインの見分け方は
      <a href="/guides/repotting/">観葉植物の植え替え、タイミングとやり方</a>にまとめています
    </li>
  </ul>

  <h2>迷ったら診断で</h2>
  <p>
    次に迎える一鉢で迷ったら、<a href="/#diagnosis">4つの質問の診断</a>で、
    お部屋に合う種類を探してみてください。
  </p>

  <RelatedGuides currentSlug={guide.slug} />

  <BackToDiagnosis />
</BaseLayout>

<style>
  /*
   * 早見表。ほかのガイドの比較表と見た目をそろえている
   * （横罫だけ・囲みの重さを出さない / design.md）。
   * 和文セルに white-space: nowrap は付けない（SP幅でページごとはみ出す /
   * 3-resources/knowledge/20260920-ja-table-nowrap-breaks-sp.md）。
   */
  .soil-disposal-table {
    width: 100%;
    margin-bottom: var(--space-2);
    border-collapse: collapse;
    font-size: var(--text-sm);
    text-align: left;
  }
  .soil-disposal-table th,
  .soil-disposal-table td {
    padding: var(--space-1);
    border-bottom: 1px solid var(--border);
    vertical-align: top;
    font-weight: 400;
  }
  .soil-disposal-table thead th {
    color: var(--muted);
    font-weight: 600;
  }
  .soil-disposal-table tbody th {
    font-weight: 600;
  }
</style>
