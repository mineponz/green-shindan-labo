---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideArticleHeader from '../../components/GuideArticleHeader.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import AmazonLink from '../../components/AmazonLink.astro';
import BackToDiagnosis from '../../components/BackToDiagnosis.astro';
import TableScroll from '../../components/TableScroll.astro';
import { findGuide } from '../../lib/guides.ts';
import { PLANTS } from '../../lib/plants.ts';

const guide = findGuide('temperature-swings')!;

/**
 * 早見表の「気をつけたいこと」。植物の slug → 一言。
 * 内容は既存ガイド（bring-indoors・seasonal-care・leaf-problems）と植物ページの記述の範囲だけ。
 * 新しい温度・日数は書かない。
 * ここに無い slug（将来種が増えたとき）は FALLBACK_NOTE で表示する。
 * 植物名・リンク・並び順・種数は plants.ts から描き、手書きしない。
 */
const SWING_NOTES: Record<string, string> = {
  pachira: '寒さはそこまで強くないので、冷え込みはじめたら早めに暖かい場所へ',
  monstera: '寒さの限界の数字が低めでも油断しないで。早めに部屋の内側へ',
  sansevieria: '寒い時期は水を控えめに。乾かし気味に育てます',
  pothos: '季節の変化に強いほう。それでも、夜の窓ぎわは避けると安心です',
  gajumaru: '置き場所や気温が変わると葉を落としやすい種類です。幹が硬ければたいてい戻るので、動かしすぎないように',
  'areca-palm': '冷えると葉が傷みやすい種類です。夜の窓ぎわは特に気をつけたいです',
  peperomia: '厚い葉に水をためるタイプなので、寒い時期の水のやりすぎに注意します',
  tillandsia: '寒さへの強さは品種による差が大きいので、心配なら早めに暖かい部屋へ',
};
const FALLBACK_NOTE = '夜の窓ぎわの冷えと、急な置き場所の変化に気をつけます';
---

<BaseLayout
  title={guide.navLabel}
  description={guide.description}
  breadcrumb={[{ label: 'ガイド記事', href: '/guides/' }]}
  ogImagePath="/og/guide-temperature-swings.jpg"
>
  <GuideArticleHeader guide={guide} />

  <h2>「寒暖差」って、植物には何がつらいの？</h2>
  <p>
    ひとくちに寒暖差といっても、実は2種類あります。
    ひとつは、1日のなかの差です。気象庁の用語では「気温の日較差」といって、
    1日の最高気温と最低気温の差のこと。予報の場面では「気温の1日の変動幅」と言い換えているそうです
    （<a href="https://www.jma.go.jp/jma/kishou/know/yougo_hp/kion.html" target="_blank" rel="noopener noreferrer">気象庁の予報用語「気温」</a>）。
    もうひとつは、日ごとの上がり下がりです。寒い日のあとに暖かい日が戻ってくる、あの感じですね。
    春なら「三寒四温」という言葉がぴったりです。
  </p>
  <p>
    植物にとってしんどいのは、気温が低いことだけではなくて、
    気温が「変わること」そのものなのかもしれない、と私は思っています。
    なので、この記事では「冷やさない」だけでなく、「振り回されない」ことを軸にまとめました。
  </p>

  <h2>見るのは「朝の最低気温」</h2>
  <p>
    日中が暖かいと、つい「もう大丈夫そう」と思ってしまいます。
    でも、植物にこたえるのは、いちばん冷え込む明け方のほうだと私は思っています。
    日中の最高気温より、朝の最低気温を見るようにすると判断しやすくなります。
    この考え方は<a href="/guides/bring-indoors/">秋の取り込みのタイミングと手順</a>と同じで、
    植物ごとの温度の目安もそちらの表にまとめています。
  </p>

  <h2>部屋のなかにも、寒暖差があります</h2>
  <p>
    外の気温だけでなく、部屋のなかにも温度の差はあります。
    とくに窓ぎわは、昼は明るくて暖かいのに、夜になるとガラスの近くからぐっと冷えてきます。
    暖房をつけたり消したりすると、昼と夜の差はさらに大きくなりますし、
    暖房の風が直接当たる場所は乾燥します。
    このあたりは<a href="/guides/bring-indoors/">秋の取り込みのタイミングと手順</a>や
    <a href="/guides/seasonal-care/">観葉植物の夏越し・冬越しガイド</a>でも触れています。
  </p>
  <p>
    私なら、置き型の温湿度計を用意して、窓ぎわや部屋の内側など、いくつかの場所の最低気温を測ってみます。
    数字で見ると、自分の家のどこが冷えるのかがはっきり分かって、置き場所を決めるときの安心材料になると思うからです。
  </p>
  <AmazonLink keyword="温湿度計 卓上" label="Amazonで「温湿度計」を見る" />

  <h2>置き場所は「夜だけ内側へ」を基本に、あちこち動かさない</h2>
  <p>
    基本は、日中は明るい窓ぎわ、夜は少し内側へ、です。
    窓の向きごとの考え方は<a href="/guides/window-direction/">窓の向き別の置き場所</a>にまとめています。
    ただ、気温が上下するたびに置き場所を大きく変えるのは、できれば控えたいところです。
    <a href="/guides/leaf-problems/">葉の症状から原因を見分ける</a>でも、
    場所を何度も変えるのがいちばんよくないと書いています。
  </p>
  <ul>
    <li>
      <strong>秋なら：</strong>
      一度部屋に取り込んだら、暖かい日が戻ってもまた外へ出し直すのは控えたい、と私は考えています。
      取り込みの手順は<a href="/guides/bring-indoors/">秋の取り込みのタイミングと手順</a>に、
      外の光に当てたいときの慣らし方は<a href="/guides/sunbathing/">観葉植物の日光浴</a>に書いています
    </li>
    <li>
      <strong>春なら：</strong>
      外に出したくなる気持ちは、とてもよく分かります。
      ただ、この時期は寒い日が戻ってくることもあるので、出しはじめは朝の最低気温を見て、夜は部屋に戻してあげてください。
      慣らし方は<a href="/guides/sunbathing/">観葉植物の日光浴</a>を参考にしてみてください
    </li>
  </ul>
  <AmazonLink keyword="キャスター付き 鉢カバー 鉢台" label="Amazonで「キャスター付きの鉢台」を見る" />

  <h2>水やりは「暖かい日の、暖かい時間帯」に</h2>
  <p>
    気温が低いと、土は乾きにくくなります。
    だから「何日に1回」と日数で決めるより、土の乾き具合を見て決めるのがいちばんです。
    考え方は<a href="/guides/watering/">観葉植物の水やりの頻度と量</a>にまとめています。
    水をあげるなら、気温が上がった昼前後を選ぶと安心です
    （<a href="/guides/seasonal-care/">観葉植物の夏越し・冬越しガイド</a>の冬の注意と同じ考え方です）。
  </p>
  <p>
    急に暖かい日が来ても、それだけで水を増やさなくていいと私は思います。
    土がまだ湿っているなら、そのまま待ってあげてください。
  </p>
  <ul>
    <li>
      <strong>秋なら：</strong>
      土の乾くペースは、だんだん遅くなっていきます。前の月と同じ感覚であげると、多くなりやすいので気をつけたいです
    </li>
    <li>
      <strong>春なら：</strong>
      乾くペースはだんだん早くなっていきます。ただ、寒い日が戻ったら、乾きもまたゆっくりになります。
      カレンダーではなく、そのときの土を見てあげてください
    </li>
  </ul>

  <h2>葉が落ちた・黄色くなったとき</h2>
  <p>
    寒暖差や置き場所の変化のあとに、葉を落とすことはあります。
    たとえばガジュマルは、置き場所を変えたときや寒くなったときに葉を落とすことがよくあります
    （<a href="/plants/gajumaru/">ガジュマルのページ</a>にも書いています）。
    幹や茎が硬いままなら、まずは様子を見てあげましょう。
  </p>
  <p>
    いちばんしたくなるのは、元気づけようとして肥料をあげたり、植え替えたりすることですよね。
    でも、弱っているときに手を入れすぎるのは、植物にはかえって負担になりそうで、私は心配になります。
  </p>
  <ul>
    <li>
      <strong>秋なら：</strong>
      肥料は10月ごろが最後の目安です。植え替えは真冬を避けて、生長期（5〜9月ごろ）まで待ちます
    </li>
    <li>
      <strong>春なら：</strong>
      肥料は、暖かくなって新芽が動き出してから。植え替えは生長期に入る5月ごろからが目安です。焦らなくて大丈夫です
    </li>
  </ul>
  <p>
    それぞれの詳しいことは、<a href="/guides/fertilizer/">観葉植物の肥料ガイド</a>と
    <a href="/guides/repotting/">観葉植物の植え替えのタイミングとやり方</a>にあります。
    症状の見分け方は<a href="/guides/leaf-problems/">葉の症状から原因を見分ける</a>、
    土がずっと湿っていて根腐れが心配なときは<a href="/guides/root-rot/">観葉植物の根腐れガイド</a>を見てみてください。
  </p>

  <h2>{PLANTS.length}種でみる、寒暖差の時期に気をつけたいこと</h2>
  <p>
    このサイトで診断に使っている{PLANTS.length}種について、寒暖差の時期に気をつけたいことをまとめました。
    温度の具体的な目安は<a href="/guides/bring-indoors/">秋の取り込みのタイミングと手順</a>の表を見てください。
  </p>
  <TableScroll label={`${PLANTS.length}種の寒暖差の時期に気をつけたいことの早見表`}>
    <table class="swings-table">
      <thead>
        <tr>
          <th scope="col">植物</th>
          <th scope="col">気をつけたいこと</th>
        </tr>
      </thead>
      <tbody>
        {PLANTS.map((plant) => (
          <tr>
            <th scope="row"><a href={`/plants/${plant.slug}/`}>{plant.name}</a></th>
            <td>{SWING_NOTES[plant.slug] ?? FALLBACK_NOTE}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </TableScroll>

  <h2>迷ったら診断で</h2>
  <p>
    季節の変わり目の置き場所は、お部屋によって答えが変わります。
    <a href="/#diagnosis">4つの質問の診断</a>では、お部屋の日当たりとお世話の手間から
    合う種類を出せるので、次に迎える一鉢の参考にしてみてください。
  </p>

  <RelatedGuides currentSlug={guide.slug} />

  <BackToDiagnosis />
</BaseLayout>

<style>
  /*
   * 早見表。ほかのガイドの比較表と見た目をそろえている。
   * 和文セルに white-space: nowrap は付けない（SP幅でページごとはみ出す）。
   */
  .swings-table {
    width: 100%;
    margin-bottom: var(--space-2);
    border-collapse: collapse;
    font-size: var(--text-sm);
    text-align: left;
  }
  .swings-table th,
  .swings-table td {
    padding: var(--space-1);
    border-bottom: 1px solid var(--border);
    vertical-align: top;
    font-weight: 400;
  }
  .swings-table thead th {
    color: var(--muted);
    font-weight: 600;
  }
  .swings-table tbody th {
    font-weight: 600;
  }
</style>
