---
import {
  SITE_URL,
  SITE_TITLE,
  SITE_TAGLINE,
  SITE_DESCRIPTION,
  AMAZON_ASSOCIATE_TAG,
  AMAZON_ASSOCIATE_TAG_PLACEHOLDER,
  GA_MEASUREMENT_ID,
} from '../consts';
import LeafMark from '../components/LeafMark.astro';

interface Props {
  /** ページ固有のタイトル。トップページでは省略する */
  title?: string;
  description?: string;
  /** パンくずの中間項目（トップとページ自身は自動で付く） */
  breadcrumb?: { label: string; href: string }[];
}

const { title, description = SITE_DESCRIPTION, breadcrumb = [] } = Astro.props;

// Amazonアソシエイトの開示文言は、審査通過前（＝タグがプレースホルダのまま）は
// 事実と異なる（まだ収入を得ていない）ため出さない。タグ差し替え後に自動で表示される。
const isAssociateTagPlaceholder = AMAZON_ASSOCIATE_TAG === AMAZON_ASSOCIATE_TAG_PLACEHOLDER;

const fullTitle = title ? `${title} | ${SITE_TITLE}` : `${SITE_TITLE} — ${SITE_TAGLINE}`;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
// SNSシェア用の画像。全ページ共通（1200x630、public/og-image.jpg）。
// 記事ごとに変える場合はPropsに追加してここで出し分ける。
const ogImage = new URL('/og-image.jpg', SITE_URL).href;

// パンくずの構造化データ。トップ → 中間 → 現在ページ
const crumbs = [
  { label: 'ホーム', href: '/' },
  ...breadcrumb,
  ...(title ? [{ label: title, href: Astro.url.pathname }] : []),
];

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    item: new URL(c.href, SITE_URL).href,
  })),
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="HmkChSgQuPhmfw3e0N9eLgLYi3bLDWkyt37TXtiapK0" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} is:inline />

    <!-- Google tag (gtag.js) -->
    <script
      async
      is:inline
      src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}
    ></script>
    <script define:vars={{ GA_MEASUREMENT_ID }} is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', GA_MEASUREMENT_ID);
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>

    <header class="site-header">
      <a href="/" class="wordmark">
        <LeafMark size={24} />
        <span>{SITE_TITLE}</span>
      </a>
      <p class="tagline">{SITE_TAGLINE}</p>
    </header>

    {crumbs.length > 1 && (
      <nav class="breadcrumb" aria-label="パンくずリスト">
        <ol>
          {crumbs.map((c, i) => (
            <li>
              {i === crumbs.length - 1 ? (
                <span aria-current="page">{c.label}</span>
              ) : (
                <a href={c.href}>{c.label}</a>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )}

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      {!isAssociateTagPlaceholder && (
        <p>
          当サイトは、Amazonアソシエイト・プログラムの参加者として、
          適格販売により収入を得ています。
        </p>
      )}
      <p>診断の回答はブラウザの中だけで処理しています（サーバーへは送信していません）。</p>
      <nav class="meta" aria-label="サイト情報">
        <a href="/">ホーム</a>
        <a href="/plants/">植物図鑑</a>
        <a href="/privacy/">プライバシーポリシー</a>
        <a href="/contact/">お問い合わせ</a>
      </nav>
    </footer>

    <style is:global>
      /*
       * デザイントークン。vault の 2-areas/playbooks/design.md のチェックリストに合わせている。
       * - 色は「役割」ごとに固定する。1色を全用途に使い回さない
       *     --accent    : プライマリ（主要CTA・リンク）
       *     --highlight : 補助強調（診断結果ラベル・おすすめバッジ）※CTAとは別色相
       *     --warn      : セマンティック警告（ペット誤食の注意）
       *     --danger    : セマンティック危険（フォームの未入力エラー）
       *   本文・背景はグレースケール寄りに保ち、色は意味のある場所だけに使う。
       * - 余白は8pxグリッド（--space-*）だけを使う。中間値をその場で足さない
       * - 見出しは比率1.25のタイプスケール（--text-*）で、個別指定しない
       */
      :root {
        --bg: #f6f9f6;
        --surface: #ffffff;
        --border: #d8e3da;
        --text: #1a1f1c;
        --muted: #5a6a5f;

        --accent: #146c43;
        --accent-weak: #e6f2ea;
        --highlight: #155e75;
        --highlight-weak: #e2f0f6;
        --warn: #8a5200;
        --warn-weak: #fdf3e0;
        --danger: #a4262c;

        /* 余白: 8pxグリッド */
        --space-1: 0.5rem; /* 8px */
        --space-2: 1rem; /* 16px */
        --space-3: 1.5rem; /* 24px */
        --space-4: 2rem; /* 32px */
        --space-6: 3rem; /* 48px */

        /* タイポ: 基準16px・比率1.25 */
        --text-sm: 0.8rem; /* 12.8px */
        --text-base: 1rem; /* 16px */
        --text-lg: 1.25rem; /* 20px */
        --text-xl: 1.5625rem; /* 25px */
        --text-2xl: 1.953rem; /* 31px */

        --radius: 8px;
        /* 和文のbold挙動が不安定な Yu Gothic は最後尾に置く */
        --sans: -apple-system, BlinkMacSystemFont, "Hiragino Kaku Gothic ProN",
          "Noto Sans JP", "Yu Gothic", sans-serif;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #131714;
          --surface: #1b211c;
          --border: #2e372f;
          --text: #e8eee9;
          --muted: #9aa89e;

          --accent: #5fd394;
          --accent-weak: #1f2f26;
          --highlight: #7ecbe8;
          --highlight-weak: #172b32;
          --warn: #e6b264;
          --warn-weak: #2e2617;
          --danger: #ef9a9a;
        }
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: var(--sans);
        font-size: var(--text-base);
        /* 和文の推奨行間（1.7〜1.8） */
        line-height: 1.8;
        -webkit-text-size-adjust: 100%;
      }

      .skip-link {
        position: absolute;
        left: -9999px;
      }
      .skip-link:focus {
        left: var(--space-2);
        top: var(--space-2);
        z-index: 10;
        background: var(--surface);
        padding: var(--space-1);
        border: 2px solid var(--accent);
        border-radius: 4px;
      }

      .site-header,
      .breadcrumb,
      main,
      .site-footer {
        max-width: 46rem;
        margin-inline: auto;
        padding-inline: var(--space-2);
      }

      .site-header {
        padding-top: var(--space-4);
        padding-bottom: var(--space-2);
      }

      .wordmark {
        display: inline-flex;
        align-items: center;
        gap: var(--space-1);
        font-size: var(--text-lg);
        font-weight: 700;
        line-height: 1.4;
        color: var(--text);
        text-decoration: none;
      }
      .wordmark:hover { color: var(--accent); }

      .tagline {
        margin: 0;
        color: var(--muted);
        font-size: var(--text-sm);
      }

      .breadcrumb ol {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-1);
        list-style: none;
        margin: 0;
        padding: 0;
        font-size: var(--text-sm);
        color: var(--muted);
      }
      .breadcrumb li + li::before {
        content: "/";
        margin-right: var(--space-1);
        color: var(--border);
      }
      .breadcrumb a { color: var(--muted); }

      main { padding-block: var(--space-3) var(--space-6); }

      h1, h2, h3 {
        line-height: 1.5;
        /* 和文見出しに欧文的な負の字間は入れない（詰まって読みにくくなる） */
      }
      h1 {
        font-size: var(--text-2xl);
        margin: var(--space-1) 0 var(--space-2);
      }
      h2 {
        font-size: var(--text-xl);
        margin-top: var(--space-6);
        margin-bottom: var(--space-2);
      }
      h3 {
        font-size: var(--text-lg);
        margin-top: var(--space-3);
        margin-bottom: var(--space-1);
      }

      p { margin-block: 0 var(--space-2); }

      a { color: var(--accent); }

      /* セクション見出しの直後は関連が強いので余白を詰める（余白でグルーピングを伝える） */
      h2 + p, h3 + p, h2 + ul, h3 + ul { margin-top: 0; }

      /* 記事本文のリスト。クラス付きのリスト（カードグリッド等）は各自の指定が優先される */
      main ul, main ol {
        margin-block: 0 var(--space-2);
        padding-left: var(--space-3);
      }
      main li { margin-bottom: var(--space-1); }

      .site-footer {
        border-top: 1px solid var(--border);
        padding-block: var(--space-3) var(--space-6);
        color: var(--muted);
        font-size: var(--text-sm);
      }
      .site-footer p { margin: 0 0 var(--space-1); }
      .site-footer .meta {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-1) var(--space-2);
      }
    </style>
  </body>
</html>
